    "Your lists are empty. Add stocks in the iPhone app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your lists are empty. Add stocks in the iPhone app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus listas están vacías. Añade acciones en la app del iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的列表是空的。请在 iPhone 应用中添加股票。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوائمك فارغة. أضف الأسهم من تطبيق iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos listes sont vides. Ajoutez des actions dans l'app iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তালিকা খালি। iPhone অ্যাপে শেয়ার যোগ করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सूचियाँ खाली हैं। iPhone ऐप में शेयर जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списки пусты. Добавьте акции в приложении на iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списки порожні. Додайте акції в застосунку на iPhone."
          }
        }
      }
    }
