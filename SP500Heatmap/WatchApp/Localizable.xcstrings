    "Your lists are empty. Add stocks in the iPhone app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوائمك فارغة. أضف الأسهم من تطبيق iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Списъците ви са празни. Добавете акции в приложението за iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তালিকা খালি। iPhone অ্যাপে শেয়ার যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves llistes són buides. Afegeix accions a l'app de l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše seznamy jsou prázdné. Přidejte akcie v aplikaci pro iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine lister er tomme. Tilføj aktier i iPhone-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Listen sind leer. Füge Aktien in der iPhone-App hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες σας είναι άδειες. Προσθέστε μετοχές στην εφαρμογή iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your lists are empty. Add stocks in the iPhone app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus listas están vacías. Añade acciones en la app del iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu loendid on tühjad. Lisa aktsiad iPhone’i rakenduses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listasi ovat tyhjiä. Lisää osakkeita iPhone-sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos listes sont vides. Ajoutez des actions dans l'app iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימות שלכם ריקות. הוסיפו מניות באפליקציית ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सूचियाँ खाली हैं। iPhone ऐप में शेयर जोड़ें।"
          }
        },
        "hr": {
