          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre premier achat ou importez un fichier CSV (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את הקנייה הראשונה שלכם או ייבאו קובץ CSV (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "hi": {
