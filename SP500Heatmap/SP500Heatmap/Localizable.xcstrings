    "This portfolio is too large for iCloud sync and is kept on this device only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المحفظة أكبر من أن تُزامن عبر iCloud وتبقى على هذا الجهاز فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този портфейл е твърде голям за синхронизиране с iCloud и се съхранява само на това устройство."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোর্টফোলিও iCloud সিঙ্কের জন্য খুব বড়; এটি শুধু এই ডিভাইসে থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta cartera és massa gran per a la sincronització amb iCloud i es manté només en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto portfolio je příliš velké pro synchronizaci přes iCloud a zůstává jen v tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne portefølje er for stor til iCloud-synkronisering og forbliver kun på denne enhed."
