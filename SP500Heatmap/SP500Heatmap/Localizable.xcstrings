          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikk ajalugu pole veel saadaval - kuvatakse 1 aasta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkä historia ei ole vielä saatavilla - näytetään 1 vuosi"
