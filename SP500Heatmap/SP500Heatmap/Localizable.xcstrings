    "The on-device model couldn't answer. Try rephrasing, or use a quick answer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على النموذج الموجود على الجهاز الإجابة. أعد صياغة السؤال أو استخدم إجابة سريعة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът на устройството не успя да отговори. Опитайте да преформулирате или използвайте бърз отговор."
