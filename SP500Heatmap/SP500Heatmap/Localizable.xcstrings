    "Some exchange rates are missing; amounts in other currencies are shown unconverted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض أسعار الصرف مفقودة؛ تُعرض المبالغ بالعملات الأخرى دون تحويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু বিনিময় হার নেই; অন্য মুদ্রার অঙ্ক রূপান্তর ছাড়াই দেখানো হচ্ছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some exchange rates are missing; amounts in other currencies are shown unconverted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan algunos tipos de cambio; los importes en otras divisas se muestran sin convertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains taux de change manquent ; les montants en autres devises sont affichés sans conversion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ विनिमय दरें उपलब्ध नहीं; अन्य मुद्राओं की राशियाँ बिना रूपांतरण दिखाई गई हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает некоторых курсов валют; суммы в других валютах показаны без пересчёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракує деяких курсів валют; суми в інших валютах показано без перерахунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少部分汇率；其他货币的金额按原值显示。"
          }
        }
      }
    },
