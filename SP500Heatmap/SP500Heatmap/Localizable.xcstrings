          }
        }
      }
    },
    "Prices may be delayed. This app is for information only and is not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتأخر الأسعار. هذا التطبيق للمعلومات فقط وليس نصيحة استثمارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দাম দেরিতে আসতে পারে। এই অ্যাপ শুধু তথ্যের জন্য, এটি বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices may be delayed. This app is for information only and is not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios pueden tener retraso. Esta app es solo informativa y no constituye asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours peuvent être différés. Cette app est donnée à titre informatif et ne constitue pas un conseil en investissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतों में देरी हो सकती है। यह ऐप केवल जानकारी के लिए है और निवेश सलाह नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены могут быть с задержкой. Приложение носит информационный характер и не является инвестиционной рекомендацией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни можуть бути із запізненням. Застосунок має інформаційний характер і не є інвестиційною порадою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格可能有延迟。本应用仅供参考，不构成投资建议。"
          }
        }
      }
    },
