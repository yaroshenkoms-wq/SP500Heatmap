    "Historical simulation, not investment advice. Past returns do not guarantee future results.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاكاة تاريخية وليست نصيحة استثمارية. العوائد السابقة لا تضمن النتائج المستقبلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐতিহাসিক সিমুলেশন, বিনিয়োগ পরামর্শ নয়। অতীতের রিটার্ন ভবিষ্যতের ফলের নিশ্চয়তা দেয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical simulation, not investment advice. Past returns do not guarantee future results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulación histórica, no es asesoramiento de inversión. La rentabilidad pasada no garantiza resultados futuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulation historique, pas un conseil en investissement. Les rendements passés ne garantissent pas les résultats futurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐतिहासिक सिमुलेशन, निवेश सलाह नहीं। अतीत का रिटर्न भविष्य के नतीजों की गारंटी नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Историческая симуляция, не инвестиционный совет. Прошлая доходность не гарантирует будущих результатов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історична симуляція, не інвестиційна порада. Минула дохідність не гарантує майбутніх результатів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史模拟,不构成投资建议。过往收益不代表未来表现。"
          }
        }
      }
    },
