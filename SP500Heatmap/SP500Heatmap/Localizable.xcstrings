    "Long periods use today's index members; companies that left the index are not counted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الفترات الطويلة تُحسب الشركات المدرجة حاليًا في المؤشر فقط؛ ولا تُحتسب الشركات التي خرجت منه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дългите периоди използват днешните членове на индекса; компаниите, напуснали индекса, не се отчитат."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দীর্ঘ মেয়াদে সূচকের বর্তমান সদস্যদের ধরা হয়; যেসব কোম্পানি সূচক থেকে বেরিয়ে গেছে, সেগুলো গোনা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els períodes llargs fan servir els components actuals de l'índex; les empreses que han sortit de l'índex no es compten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouhá období používají dnešní složení indexu; společnosti, které index opustily, se nezapočítávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange perioder bruger dagens indeksmedlemmer; virksomheder, der har forladt indekset, tælles ikke med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Zeiträume nutzen die heutigen Indexmitglieder; Unternehmen, die den Index verlassen haben, werden nicht berücksichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μεγάλες περίοδοι χρησιμοποιούν τα σημερινά μέλη του δείκτη· οι εταιρείες που αποχώρησαν από τον δείκτη δεν υπολογίζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En periodos largos se usan los miembros actuales del índice; las empresas que salieron no se cuentan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikad perioodid kasutavad indeksi praeguseid liikmeid; indeksist lahkunud ettevõtteid ei arvestata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkät jaksot käyttävät indeksin nykyisiä jäseniä; indeksistä poistuneita yhtiöitä ei lasketa mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les longues périodes, seuls les membres actuels de l'indice sont pris en compte ; les sociétés sorties ne sont pas comptées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופות ארוכות משתמשות בחברי המדד של היום; חברות שיצאו מהמדד אינן נספרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबी अवधि में सूचकांक के मौजूदा सदस्य ही गिने जाते हैं; जो कंपनियाँ सूचकांक से बाहर हो गईं, वे शामिल नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugi periodi koriste današnje članove indeksa; tvrtke koje su napustile indeks ne ubrajaju se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hosszú időszakok a mai indextagokat használják; az indexből kikerült cégek nem számítanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periode panjang memakai anggota indeks saat ini; perusahaan yang keluar dari indeks tidak dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I periodi lunghi usano i componenti attuali dell'indice; le aziende uscite dall'indice non sono conteggiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期では現在の指数構成銘柄を使用します。指数から外れた企業は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기 기간에는 현재 지수 구성 종목을 사용하며, 지수에서 빠진 기업은 포함되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgi laikotarpiai naudoja dabartinius indekso narius; indeksą palikusios įmonės neskaičiuojamos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgiem periodiem tiek izmantoti indeksa pašreizējie dalībnieki; uzņēmumi, kas indeksu pametuši, netiek ņemti vērā."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempoh panjang menggunakan ahli indeks hari ini; syarikat yang telah keluar daripada indeks tidak dikira."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange perioder bruker dagens indeksmedlemmer; selskaper som har forlatt indeksen, telles ikke med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange periodes gebruiken de huidige indexleden; bedrijven die de index hebben verlaten, tellen niet mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie okresy używają dzisiejszych składników indeksu; spółki, które go opuściły, nie są wliczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Períodos longos usam os componentes atuais do índice; empresas que saíram do índice não são contadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Períodos longos usam os componentes atuais do índice; empresas que saíram do índice não são contadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioadele lungi folosesc componentele actuale ale indicelui; companiile care au ieșit din indice nu sunt luate în calcul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для длинных сроков берутся нынешние участники индекса; компании, которые из него вышли, не учитываются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlhé obdobia používajú dnešné zloženie indexu; spoločnosti, ktoré index opustili, sa nezapočítavajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolga obdobja uporabljajo današnje člane indeksa; podjetja, ki so indeks zapustila, niso upoštevana."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugi periodi koriste današnje članove indeksa; kompanije koje su napustile indeks ne računaju se."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långa perioder använder dagens indexmedlemmar; företag som lämnat indexet räknas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงยาวใช้หุ้นที่เป็นสมาชิกดัชนีในปัจจุบัน บริษัทที่ออกจากดัชนีแล้วจะไม่ถูกนับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun dönemler bugünkü endeks üyelerini kullanır; endeksten çıkan şirketler sayılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для довгих строків беруться нинішні учасники індексу; компанії, що з нього вийшли, не враховуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giai đoạn dài dùng các thành viên hiện tại của chỉ số; công ty đã rời chỉ số không được tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期数据按指数当前成分股计算，已退出指数的公司不计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長期區間使用目前的指數成分股，已退出指數的公司不計入。"
          }
        }
      }
    },
