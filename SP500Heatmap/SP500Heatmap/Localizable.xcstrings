    "Candles and volume are unavailable: showing closing prices only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candles and volume are unavailable: showing closing prices only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velas y volumen no disponibles: solo se muestran los precios de cierre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示K线和成交量：仅显示收盘价。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشموع وحجم التداول غير متاحة: تُعرض أسعار الإغلاق فقط."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chandeliers et volume indisponibles : seuls les cours de clôture sont affichés."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যান্ডেল ও ভলিউম পাওয়া যাচ্ছে না: শুধু ক্লোজিং দাম দেখানো হচ্ছে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैंडल और वॉल्यूम उपलब्ध नहीं: केवल क्लोज़िंग भाव दिख रहे हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свечи и объём недоступны: показаны только цены закрытия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свічки й обсяг недоступні: показано лише ціни закриття."
          }
        }
      }
    },
    "Checked in the background. iOS decides when that runs, so the alert may be delayed or skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in the background. iOS decides when that runs, so the alert may be delayed or skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprueba en segundo plano. iOS decide cuándo, así que la alerta puede retrasarse u omitirse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台检查，运行时间由 iOS 决定，因此提醒可能延迟或被跳过。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفحص في الخلفية، ويقرر iOS وقت ذلك، لذا قد يتأخر التنبيه أو يُتجاوز."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiée en arrière-plan. iOS décide du moment, l’alerte peut donc être retardée ou manquée."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ডে যাচাই হয়। কখন চলবে তা iOS ঠিক করে, তাই সতর্কতা দেরিতে আসতে বা বাদ পড়তে পারে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड में जाँचा जाता है। कब चलेगा यह iOS तय करता है, इसलिए अलर्ट देर से आ सकता है या छूट सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяется в фоне. Когда это происходит, решает iOS, поэтому оповещение может запаздывать или пропускаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряється у фоні. Коли саме, вирішує iOS, тому сповіщення може запізнюватися або пропускатися."
          }
        }
      }
    },
