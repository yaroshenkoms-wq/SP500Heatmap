    "AI-generated, may be inaccurate. Not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُنشأ بالذكاء الاصطناعي وقد يكون غير دقيق. ليس نصيحة استثمارية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерирано от AI, може да е неточно. Не е инвестиционен съвет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এআই দ্বারা তৈরি, ভুল হতে পারে। বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Generat per IA, pot ser inexacte. No és assessorament d'inversió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerováno AI, může být nepřesné. Nejde o investiční poradenství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-genereret, kan være unøjagtigt. Ikke investeringsrådgivning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-generiert, kann Fehler enthalten. Keine Anlageberatung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήθηκε από AI, ενδέχεται να είναι ανακριβές. Δεν αποτελεί επενδυτική συμβουλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-generated, may be inaccurate. Not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generado por IA, puede contener errores. No es asesoramiento de inversión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehisintellekti loodud, võib olla ebatäpne. Mitte investeerimisnõu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyn tuottama, voi olla epätarkka. Ei sijoitusneuvontaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré par IA, peut être inexact. Ne constitue pas un conseil en investissement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוצר על ידי AI, ייתכנו אי-דיוקים. אין זו ייעוץ השקעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई द्वारा बनाया गया, गलत हो सकता है। निवेश सलाह नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Generirao AI, može biti netočno. Nije investicijski savjet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "MI által generált, pontatlan lehet. Nem minősül befektetési tanácsnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat oleh AI, mungkin tidak akurat. Bukan saran investasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generato dall'IA, può contenere errori. Non è una consulenza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIが生成した内容には誤りが含まれる場合があります。投資助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 생성한 내용으로 부정확할 수 있습니다. 투자 조언이 아닙니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukurta DI, gali būti netiksli. Tai nėra investicinė konsultacija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "MI ģenerēts, var būt neprecīzs. Nav ieguldījumu padoms."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijana oleh AI, mungkin tidak tepat. Bukan nasihat pelaburan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-generert, kan være unøyaktig. Ikke investeringsråd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door AI gegenereerd, kan onjuist zijn. Geen beleggingsadvies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygenerowane przez AI, może zawierać błędy. To nie jest porada inwestycyjna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado por IA, pode conter imprecisões. Não é recomendação de investimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado por IA, pode conter imprecisões. Não é recomendação de investimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Generat de AI, poate fi inexact. Nu reprezintă consultanță de investiții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано ИИ, может содержать ошибки. Не является инвестиционной рекомендацией."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerované AI, môže byť nepresné. Nejde o investičné poradenstvo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvaril UI, lahko je netočno. Ni naložbeno svetovanje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Generisao AI, može biti netačno. Nije investicioni savet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-genererat, kan vara felaktigt. Inte investeringsrådgivning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างโดย AI อาจไม่ถูกต้อง ไม่ใช่คำแนะนำในการลงทุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka tarafından oluşturuldu, hatalı olabilir. Yatırım tavsiyesi değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено ШІ, може бути неточним. Не є інвестиційною порадою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do AI tạo, có thể không chính xác. Không phải lời khuyên đầu tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 AI 生成,可能不准确。不构成投资建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容由 AI 產生，可能不準確。非投資建議。"
          }
        }
      }
    },
