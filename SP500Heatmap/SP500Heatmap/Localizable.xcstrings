    "Checked in the background. iOS decides when that runs, so the alert may be delayed or skipped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفحص في الخلفية، ويقرر iOS وقت ذلك، لذا قد يتأخر التنبيه أو يُتجاوز."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверява се във фонов режим. iOS решава кога се изпълнява това, затова известието може да закъснее или да бъде пропуснато."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ডে যাচাই হয়। কখন চলবে তা iOS ঠিক করে, তাই সতর্কতা দেরিতে আসতে বা বাদ পড়তে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprovat en segon pla. iOS decideix quan s'executa, de manera que l'avís pot endarrerir-se o ometre's."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolováno na pozadí. Kdy se to děje, rozhoduje iOS, takže upozornění může přijít se zpožděním nebo vynechat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolleres i baggrunden. iOS bestemmer, hvornår det sker, så alarmen kan blive forsinket eller udeblive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Hintergrund geprüft. iOS entscheidet, wann das geschieht, daher kann der Alarm verzögert kommen oder ausfallen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχεται στο παρασκήνιο. Το iOS αποφασίζει πότε εκτελείται ο έλεγχος, γι’ αυτό η ειδοποίηση μπορεί να καθυστερήσει ή να παραλειφθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in the background. iOS decides when that runs, so the alert may be delayed or skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprueba en segundo plano. iOS decide cuándo, así que la alerta puede retrasarse u omitirse."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollitakse taustal. iOS otsustab, millal see juhtub, seega võib teavitus hilineda või ära jääda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan taustalla. iOS päättää, milloin se tapahtuu, joten hälytys voi viivästyä tai jäädä tulematta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiée en arrière-plan. iOS décide du moment, l’alerte peut donc être retardée ou manquée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבדק ברקע. iOS קובעת מתי הבדיקה רצה, ולכן ההתראה עלולה להתעכב או להידלג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड में जाँचा जाता है। कब चलेगा यह iOS तय करता है, इसलिए अलर्ट देर से आ सकता है या छूट सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerava se u pozadini. iOS odlučuje kada se to pokreće, pa upozorenje može kasniti ili izostati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A háttérben ellenőrizzük. Hogy ez mikor fut le, azt az iOS dönti el, ezért az értesítés késhet vagy kimaradhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperiksa di latar belakang. iOS yang menentukan kapan itu berjalan, sehingga peringatan bisa tertunda atau terlewat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllato in background. iOS decide quando, quindi l'avviso può arrivare in ritardo o saltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで確認されます。実行タイミングはiOSが決めるため、アラートが遅れたりスキップされたりすることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 확인됩니다. 실행 시점은 iOS가 결정하므로 알림이 늦거나 건너뛸 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikrinama fone. „iOS“ nusprendžia, kada tai vyksta, todėl įspėjimas gali vėluoti arba būti praleistas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiek pārbaudīts fonā. iOS nosaka, kad tas notiek, tāpēc brīdinājums var kavēties vai nenotikt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disemak di latar belakang. iOS yang menentukan bila ia dijalankan, jadi amaran mungkin lewat atau terlepas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekkes i bakgrunnen. iOS avgjør når det skjer, så varselet kan bli forsinket eller utebli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt op de achtergrond gecontroleerd. iOS bepaalt wanneer dat gebeurt, dus de melding kan vertraagd zijn of ontbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzane w tle. To iOS decyduje, kiedy to się dzieje, więc alert może się opóźnić lub zostać pominięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado em segundo plano. O iOS decide quando isso ocorre, então o alerta pode atrasar ou ser ignorado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado em segundo plano. O iOS decide quando isso ocorre, então o alerta pode atrasar ou ser ignorado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificat în fundal. iOS decide când se întâmplă asta, deci alerta poate întârzia sau poate fi omisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяется в фоне. Когда это происходит, решает iOS, поэтому оповещение может запаздывать или пропускаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolované na pozadí. Kedy sa to deje, rozhoduje iOS, takže upozornenie môže prísť oneskorene alebo sa vynechať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverja se v ozadju. iOS odloča, kdaj se to izvede, zato lahko opozorilo zamuja ali izostane."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Proverava se u pozadini. iOS odlučuje kada se to pokreće, pa upozorenje može kasniti ili izostati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolleras i bakgrunden. iOS avgör när det sker, så aviseringen kan bli försenad eller utebli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบในเบื้องหลัง iOS เป็นผู้กำหนดว่าจะทำงานเมื่อใด การแจ้งเตือนจึงอาจล่าช้าหรือถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda kontrol edilir. Ne zaman çalışacağına iOS karar verir; bu yüzden uyarı gecikebilir veya atlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряється у фоні. Коли саме, вирішує iOS, тому сповіщення може запізнюватися або пропускатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được kiểm tra ở chế độ nền. iOS quyết định khi nào chạy, nên cảnh báo có thể bị trễ hoặc bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台检查，运行时间由 iOS 决定，因此提醒可能延迟或被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於背景檢查。執行時機由 iOS 決定，因此提醒可能延遲或被略過。"
          }
        }
      }
    },
