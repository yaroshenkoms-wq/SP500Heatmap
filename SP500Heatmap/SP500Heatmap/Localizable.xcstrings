    },
    "Push alerts are sent by our server, even when the app is closed. News alerts need push.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل خادمنا التنبيهات الفورية حتى عند إغلاق التطبيق. تنبيهات الأخبار تتطلب الإشعارات الفورية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বন্ধ থাকলেও আমাদের সার্ভার পুশ অ্যালার্ট পাঠায়। খবরের অ্যালার্টের জন্য পুশ দরকার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push alerts are sent by our server, even when the app is closed. News alerts need push."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas push las envía nuestro servidor, incluso con la app cerrada. Las alertas de noticias requieren push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes push sont envoyées par notre serveur, même app fermée. Les alertes d'actualités nécessitent le push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने पर भी हमारा सर्वर पुश अलर्ट भेजता है। खबरों के अलर्ट के लिए पुश ज़रूरी है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-оповещения отправляет наш сервер, даже когда приложение закрыто. Для новостей нужен push."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-сповіщення надсилає наш сервер, навіть коли застосунок закрито. Для новин потрібен push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送提醒由我们的服务器发送，即使应用已关闭也会收到。新闻提醒需要推送。"
          }
        }
      }
    },
