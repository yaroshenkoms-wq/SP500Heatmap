    "Prices are the last close; the S&P 500 may show live prices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار هي آخر إغلاق؛ وقد يعرض S&P 500 أسعارًا مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দামগুলো শেষ ক্লোজিং; S&P 500-এ লাইভ দাম দেখাতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are the last close; the S&P 500 may show live prices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios son el último cierre; el S&P 500 puede mostrar precios en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours sont la dernière clôture ; le S&P 500 peut afficher des cours en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतें पिछला बंद भाव हैं; S&P 500 लाइव कीमतें दिखा सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены — последнее закрытие; для S&P 500 могут показываться live-цены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни — останнє закриття; для S&P 500 можуть показуватись live-ціни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
