    "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم وقيمة التداول يُطبَّقان على خرائط الشركات؛ وحيث لا توجد بيانات تُستخدم القيمة السوقية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обемът и оборотът важат за картите на компании; световните карти и картите на сектори използват пазарна капитализация, където няма данни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভলিউম ও লেনদেনের মূল্য কোম্পানির মানচিত্রে প্রযোজ্য; তথ্য না থাকলে বাজার মূলধন ব্যবহৃত হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El volum i el volum negociat s'apliquen als mapes d'empreses; els mapes mundials i de sectors fan servir la capitalització quan no hi ha dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem a obrat platí pro mapy společností; světové a sektorové mapy používají tržní kapitalizaci, pokud nejsou data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen og omsætningshastighed gælder for virksomhedskort; verdens- og sektorkort bruger markedsværdi, hvor der ikke er data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen und Umschlag gelten für Unternehmenskarten; Welt- und Sektorkarten nutzen die Marktkapitalisierung, wenn keine Daten vorliegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο όγκος και ο όγκος συναλλαγών ισχύουν για χάρτες εταιρειών· οι χάρτες κόσμου και κλάδων χρησιμοποιούν την κεφαλαιοποίηση όπου δεν υπάρχουν δεδομένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen y el volumen negociado se aplican a los mapas de empresas; donde no hay datos se usa la capitalización."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Maht ja käibekiirus kehtivad ettevõtete kaartidel; maailma ja sektorite kaardid kasutavad turuväärtust, kui andmeid pole."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volyymi ja kiertonopeus koskevat yrityskarttoja; maailman- ja toimialakartat käyttävät markkina-arvoa, kun tietoja ei ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume et le montant échangé s'appliquent aux cartes des sociétés ; sans données, la capitalisation est utilisée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נפח ומחזור חלים על מפות חברות; במפות עולמיות וסקטוריאליות משתמשים בשווי שוק כשאין נתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम और कारोबार कंपनी मानचित्रों पर लागू होते हैं; डेटा न होने पर बाज़ार पूँजी इस्तेमाल होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen i promet odnose se na karte tvrtki; svjetske karte i karte sektora koriste tržišnu kapitalizaciju kad nema podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgalom és a kereskedett érték a cégtérképekre vonatkozik; a világ- és szektortérképek adat hiányában a piaci kapitalizációt használják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume dan nilai transaksi berlaku untuk peta perusahaan; peta dunia dan sektor memakai kapitalisasi pasar bila tidak ada data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume e controvalore scambiato valgono per le mappe delle aziende; le mappe mondiali e dei settori usano la capitalizzazione quando mancano i dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出来高と売買代金は個別企業のマップに適用されます。世界マップとセクターマップでは、データがない場合は時価総額を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래량과 거래대금은 기업 맵에 적용되며, 세계 및 섹터 맵은 데이터가 없는 경우 시가총액을 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apimtis ir apyvarta taikomos įmonių žemėlapiams; pasaulio ir sektorių žemėlapiuose, kai duomenų nėra, naudojama rinkos kapitalizacija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apjoms un apgrozījuma ātrums attiecas uz uzņēmumu kartēm; pasaules un nozaru kartes izmanto tirgus kapitalizāciju, ja datu nav."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum dan nilai dagangan terpakai untuk peta syarikat; peta dunia dan sektor menggunakan permodalan pasaran apabila tiada data."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum og omløpshastighet gjelder for selskapskart; verdens- og sektorkart bruker markedsverdi der det ikke finnes data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume en omzetsnelheid gelden voor bedrijfskaarten; wereld- en sectorkaarten gebruiken marktkapitalisatie als er geen gegevens zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolumen i obrót dotyczą map spółek; mapy światowe i sektorowe używają kapitalizacji, gdy brak danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume e giro financeiro se aplicam aos mapas de empresas; mapas mundiais e de setores usam o valor de mercado quando não há dados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume e volume de negócios se aplicam aos mapas de empresas; mapas mundiais e de setores usam o valor de mercado quando não há dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul și valoarea tranzacționată se aplică hărților companiilor; hărțile mondiale și ale sectoarelor folosesc capitalizarea bursieră când nu există date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объём и оборот работают на картах компаний; где данных нет, используется капитализация."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem a obrat platia pre mapy spoločností; svetové a sektorové mapy používajú trhovú kapitalizáciu, ak nie sú údaje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obseg in promet veljata za zemljevide podjetij; svetovni zemljevidi in zemljevidi sektorjev uporabljajo tržno kapitalizacijo, kjer ni podatkov."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obim i promet odnose se na mape kompanija; svetske mape i mape sektora koriste tržišnu kapitalizaciju kad nema podataka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volym och omsättningshastighet gäller företagskartor; världs- och sektorkartor använder börsvärde när data saknas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณและมูลค่าการซื้อขายใช้กับแผนที่บริษัท ส่วนแผนที่ตลาดโลกและกลุ่มอุตสาหกรรมใช้มูลค่าตลาดเมื่อไม่มีข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacim ve işlem tutarı şirket haritaları için geçerlidir; dünya ve sektör haritaları veri olmadığında piyasa değerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсяг і оборот працюють на картах компаній; де даних немає, використовується капіталізація."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối lượng và giá trị giao dịch áp dụng cho bản đồ công ty; bản đồ thế giới và ngành dùng vốn hóa khi không có dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成交量和成交额用于公司地图；没有数据的地图使用市值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成交量與成交值適用於公司地圖；全球與類股地圖在沒有資料時使用市值。"
          }
        }
      }
    },
