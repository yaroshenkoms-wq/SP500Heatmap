    "Open a company and tap the star, or long-press a tile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح شركة واضغط على النجمة، أو اضغط مطولاً على مربع."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете компания и докоснете звездата или натиснете дълго върху плочка."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কোম্পানি খুলে তারা চাপুন, অথবা কোনো টাইলে দীর্ঘক্ষণ চেপে ধরুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre una empresa i toca l'estrella, o mantén premut un mosaic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete společnost a klepněte na hvězdičku, nebo dlouze stiskněte dlaždici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn en virksomhed og tryk på stjernen, eller hold en flise nede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein Unternehmen und tippe auf den Stern oder halte eine Kachel gedrückt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε μια εταιρεία και πατήστε το αστέρι ή πατήστε παρατεταμένα ένα πλακίδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a company and tap the star, or long-press a tile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una empresa y toca la estrella, o mantén pulsado un recuadro."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava ettevõte ja puuduta tähte või vajuta paanile pikalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa yritys ja napauta tähteä tai paina ruutua pitkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une entreprise et touchez l’étoile, ou appuyez longuement sur une tuile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו חברה ולחצו על הכוכב, או לחצו לחיצה ארוכה על אריח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कंपनी को खोलें और तारे पर टैप करें, या किसी टाइल को देर तक दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite tvrtku i dodirnite zvjezdicu ili dugo pritisnite pločicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisson meg egy céget, és koppintson a csillagra, vagy nyomjon hosszan egy csempére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka sebuah perusahaan lalu ketuk bintang, atau tekan lama sebuah petak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un'azienda e tocca la stella, oppure tieni premuto un riquadro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業を開いて星をタップするか、タイルを長押ししてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기업을 열어 별표를 탭하거나 타일을 길게 누르세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite įmonę ir bakstelėkite žvaigždutę arba ilgai paspauskite plytelę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveriet uzņēmumu un pieskarieties zvaigznītei vai turiet nospiestu flīzi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka sesebuah syarikat dan ketik bintang, atau tekan lama pada jubin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne et selskap og trykk på stjernen, eller hold inne en rute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een bedrijf en tik op de ster, of houd een tegel ingedrukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz spółkę i stuknij gwiazdkę lub przytrzymaj kafelek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma empresa e toque na estrela, ou mantenha pressionado um bloco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma empresa e toque na estrela, ou prima sem soltar um mosaico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide o companie și atinge steaua sau ține apăsat pe un bloc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте компанию и нажмите звезду или удерживайте плитку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte spoločnosť a ťuknite na hviezdičku, alebo dlho stlačte dlaždicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite podjetje in tapnite zvezdico ali dolgo pritisnite ploščico."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite kompaniju i dodirnite zvezdicu ili dugo pritisnite pločicu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna ett företag och tryck på stjärnan, eller tryck länge på en ruta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบริษัทแล้วแตะดาว หรือกดบนไทล์ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şirketi açıp yıldıza dokunun veya bir kutucuğa uzun basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте компанію та натисніть зірку або утримуйте плитку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một công ty rồi chạm vào ngôi sao, hoặc nhấn giữ một ô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一家公司并点按星标，或长按方块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟一家公司並點一下星號，或長按方塊。"
          }
        }
      }
    },
