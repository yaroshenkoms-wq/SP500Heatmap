    "Candles and volume are unavailable: showing closing prices only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشموع وحجم التداول غير متاحة: تُعرض أسعار الإغلاق فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свещите и обемът не са налични: показват се само цените на затваряне."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যান্ডেল ও ভলিউম পাওয়া যাচ্ছে না: শুধু ক্লোজিং দাম দেখানো হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelmes i volum no disponibles: només es mostren els preus de tancament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svíčky a objem nejsou k dispozici: zobrazují se pouze závěrečné ceny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lysestager og volumen er ikke tilgængelige: kun lukkekurser vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerzen und Volumen sind nicht verfügbar: Es werden nur Schlusskurse angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κεριά και ο όγκος δεν είναι διαθέσιμα: εμφανίζονται μόνο οι τιμές κλεισίματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candles and volume are unavailable: showing closing prices only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velas y volumen no disponibles: solo se muestran los precios de cierre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küünlad ja maht pole saadaval: kuvatakse ainult sulgemishindu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kynttilät ja volyymi eivät ole saatavilla: näytetään vain päätöskurssit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chandeliers et volume indisponibles : seuls les cours de clôture sont affichés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נרות ונפח אינם זמינים: מוצגים מחירי סגירה בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैंडल और वॉल्यूम उपलब्ध नहीं: केवल क्लोज़िंग भाव दिख रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svijeće i volumen nisu dostupni: prikazuju se samo zaključne cijene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyertyák és a forgalom nem érhetők el: csak záróárak láthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Candlestick dan volume tidak tersedia: hanya menampilkan harga penutupan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Candele e volumi non disponibili: vengono mostrati solo i prezzi di chiusura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローソク足と出来高は利用できません。終値のみ表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔들과 거래량을 사용할 수 없습니다. 종가만 표시합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žvakės ir apimtis nepasiekiamos: rodomos tik uždarymo kainos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svečturi un apjoms nav pieejami: tiek rādītas tikai slēgšanas cenas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Candlestick dan volum tidak tersedia: hanya harga penutup dipaparkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lysestaker og volum er ikke tilgjengelig: bare sluttkurser vises."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Candlesticks en volume zijn niet beschikbaar: alleen slotkoersen worden getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świece i wolumen są niedostępne: pokazano tylko ceny zamknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Candles e volume indisponíveis: exibindo apenas os preços de fechamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Candles e volume indisponíveis: a mostrar apenas os preços de fecho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumânările și volumul nu sunt disponibile: se afișează doar prețurile de închidere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свечи и объём недоступны: показаны только цены закрытия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviečky a objem nie sú k dispozícii: zobrazujú sa iba záverečné ceny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Svečniki in obseg nista na voljo: prikazane so le zaključne cene."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveće i obim nisu dostupni: prikazuju se samo zaključne cene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljus och volym är inte tillgängliga: endast slutkurser visas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลแท่งเทียนและปริมาณซื้อขาย: แสดงเฉพาะราคาปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mum grafik ve hacim kullanılamıyor: yalnızca kapanış fiyatları gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свічки й обсяг недоступні: показано лише ціни закриття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có biểu đồ nến và khối lượng: chỉ hiển thị giá đóng cửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示K线和成交量：仅显示收盘价。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 K 線與成交量：僅顯示收盤價。"
          }
        }
      }
