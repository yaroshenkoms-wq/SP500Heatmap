    "Add buys, sells and dividends to see value, profit, allocation and performance against an index.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عمليات الشراء والبيع والأرباح لعرض القيمة والربح والتوزيع والأداء مقابل مؤشر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете покупки, продажби и дивиденти, за да видите стойност, печалба, разпределение и представяне спрямо индекс."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য, লাভ, বণ্টন এবং সূচকের তুলনায় পারফরম্যান্স দেখতে ক্রয়, বিক্রয় ও লভ্যাংশ যোগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix compres, vendes i dividends per veure valor, benefici, assignació i rendiment respecte a un índex."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte nákupy, prodeje a dividendy a uvidíte hodnotu, zisk, alokaci a výkonnost oproti indexu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj køb, salg og udbytter for at se værdi, gevinst, fordeling og udvikling i forhold til et indeks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Käufe, Verkäufe und Dividenden hinzu, um Wert, Gewinn, Aufteilung und Performance im Vergleich zu einem Index zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε αγορές, πωλήσεις και μερίσματα για να δείτε αξία, κέρδος, κατανομή και απόδοση σε σύγκριση με δείκτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add buys, sells and dividends to see value, profit, allocation and performance against an index."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade compras, ventas y dividendos para ver valor, beneficio, distribución y rentabilidad frente a un índice."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa ostud, müügid ja dividendid, et näha väärtust, kasumit, jaotust ja tootlust indeksiga võrreldes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ostot, myynnit ja osingot nähdäksesi arvon, voiton, jakauman ja kehityksen indeksiin verrattuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez achats, ventes et dividendes pour voir la valeur, le gain, la répartition et la performance face à un indice."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו קניות, מכירות ודיבידנדים כדי לראות שווי, רווח, הקצאה וביצועים לעומת מדד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य, लाभ, आवंटन और इंडेक्स के मुकाबले प्रदर्शन देखने के लिए खरीद, बिक्री और लाभांश जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kupnje, prodaje i dividende da vidite vrijednost, dobit, raspodjelu i uspješnost u odnosu na indeks."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá vásárlásokat, eladásokat és osztalékokat, hogy lássa az értéket, a hozamot, az allokációt és az indexhez mért teljesítményt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pembelian, penjualan, dan dividen untuk melihat nilai, laba, alokasi, dan kinerja dibandingkan indeks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi acquisti, vendite e dividendi per vedere valore, profitto, allocazione e performance rispetto a un indice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い、売り、配当を追加すると、評価額、損益、配分、指数との比較が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매수, 매도, 배당을 추가하면 평가액, 손익, 자산 배분, 지수 대비 성과를 볼 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite pirkimus, pardavimus ir dividendus, kad matytumėte vertę, pelną, paskirstymą ir rezultatus, palyginus su indeksu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet pirkumus, pārdevumus un dividendes, lai redzētu vērtību, peļņu, sadalījumu un rezultātus salīdzinājumā ar indeksu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah pembelian, jualan dan dividen untuk melihat nilai, untung, peruntukan dan prestasi berbanding indeks."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til kjøp, salg og utbytter for å se verdi, gevinst, fordeling og utvikling sammenlignet med en indeks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg aankopen, verkopen en dividenden toe om waarde, winst, verdeling en prestaties ten opzichte van een index te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zakupy, sprzedaże i dywidendy, aby zobaczyć wartość, zysk, alokację i wyniki na tle indeksu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione compras, vendas e dividendos para ver valor, lucro, alocação e desempenho em relação a um índice."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione compras, vendas e dividendos para ver valor, lucro, alocação e desempenho em relação a um índice."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă achiziții, vânzări și dividende pentru a vedea valoarea, profitul, alocarea și performanța față de un indice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте покупки, продажи и дивиденды, чтобы увидеть стоимость, прибыль, структуру и доходность в сравнении с индексом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte nákupy, predaje a dividendy a uvidíte hodnotu, zisk, alokáciu a výkonnosť oproti indexu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte nakupe, prodaje in dividende, da vidite vrednost, dobiček, razporeditev in uspešnost glede na indeks."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kupovine, prodaje i dividende da biste videli vrednost, dobit, raspodelu i učinak u odnosu na indeks."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till köp, försäljningar och utdelningar för att se värde, vinst, fördelning och utveckling jämfört med ett index."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรายการซื้อ ขาย และเงินปันผลเพื่อดูมูลค่า กำไร การจัดสรร และผลตอบแทนเทียบกับดัชนี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değeri, kârı, dağılımı ve endekse göre performansı görmek için alım, satım ve temettü ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте купівлі, продажі та дивіденди, щоб побачити вартість, прибуток, структуру й дохідність порівняно з індексом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm lệnh mua, bán và cổ tức để xem giá trị, lãi lỗ, phân bổ và hiệu suất so với chỉ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加买入、卖出和股息，即可查看市值、收益、配置以及相对指数的表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增買進、賣出與股息，即可查看市值、損益、配置，以及與指數的績效比較。"
          }
        }
      }
    },
