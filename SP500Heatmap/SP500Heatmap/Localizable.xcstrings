    "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم وقيمة التداول يُطبَّقان على خرائط الشركات؛ وحيث لا توجد بيانات تُستخدم القيمة السوقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভলিউম ও লেনদেনের মূল্য কোম্পানির মানচিত্রে প্রযোজ্য; তথ্য না থাকলে বাজার মূলধন ব্যবহৃত হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen y el volumen negociado se aplican a los mapas de empresas; donde no hay datos se usa la capitalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume et le montant échangé s'appliquent aux cartes des sociétés ; sans données, la capitalisation est utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम और कारोबार कंपनी मानचित्रों पर लागू होते हैं; डेटा न होने पर बाज़ार पूँजी इस्तेमाल होती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объём и оборот работают на картах компаний; где данных нет, используется капитализация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсяг і оборот працюють на картах компаній; де даних немає, використовується капіталізація."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成交量和成交额用于公司地图；没有数据的地图使用市值。"
          }
        }
      }
    },
