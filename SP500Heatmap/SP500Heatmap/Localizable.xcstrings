    "Index history is not available from the server yet; showing the portfolio only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل المؤشر غير متاح من الخادم بعد؛ يُعرض أداء المحفظة فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Историята на индекса още не е налична от сървъра; показва се само портфейлът."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূচকের ইতিহাস এখনও সার্ভারে নেই; শুধু পোর্টফোলিও দেখানো হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historial de l'índex encara no està disponible al servidor; només es mostra la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie indexu zatím není ze serveru k dispozici; zobrazuje se pouze portfolio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indekshistorik er endnu ikke tilgængelig fra serveren; kun porteføljen vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Indexverlauf ist vom Server noch nicht verfügbar; es wird nur das Portfolio angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό του δείκτη δεν είναι ακόμη διαθέσιμο από τον διακομιστή· εμφανίζεται μόνο το χαρτοφυλάκιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index history is not available from the server yet; showing the portfolio only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del índice aún no está disponible en el servidor; se muestra solo la cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksi ajalugu pole serverist veel saadaval; kuvatakse ainult portfelli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksin historiaa ei ole vielä saatavilla palvelimelta; näytetään vain salkku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique de l’indice n’est pas encore disponible sur le serveur ; seul le portefeuille est affiché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריית המדד עדיין אינה זמינה מהשרת; מוצג התיק בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंडेक्स का इतिहास अभी सर्वर पर उपलब्ध नहीं है; केवल पोर्टफ़ोलियो दिखाया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest indeksa još nije dostupna sa servera; prikazuje se samo portfelj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az index előzményei még nem érhetők el a szerverről; csak a portfólió látható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat indeks belum tersedia dari server; hanya menampilkan portofolio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo storico dell'indice non è ancora disponibile dal server; viene mostrato solo il portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
