        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào biểu tượng trực tiếp trên bản đồ chỉ số để theo dõi trên Màn hình khóa và Dynamic Island. Máy chủ cập nhật kể cả khi ứng dụng đã đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指数地图上点按实时图标，即可在锁定屏幕和灵动岛中关注该指数。即使应用已关闭，服务器也会更新。"
          }
