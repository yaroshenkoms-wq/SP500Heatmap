    "Headlines come from public sources. AI-generated summaries may be inaccurate. Not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين من مصادر عامة. قد تكون الملخصات التي ينشئها الذكاء الاصطناعي غير دقيقة. ليست نصيحة استثمارية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглавията идват от публични източници. Резюметата, генерирани от AI, може да са неточни. Не са инвестиционен съвет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনামগুলো পাবলিক উৎস থেকে নেওয়া। AI-তৈরি সারাংশ ভুল হতে পারে। এটি বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els titulars provenen de fonts públiques. Els resums generats per IA poden ser inexactes. No és assessorament d'inversió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky pocházejí z veřejných zdrojů. Souhrny generované AI mohou být nepřesné. Nejde o investiční poradenství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskrifter stammer fra offentlige kilder. AI-genererede resuméer kan være unøjagtige. Ikke investeringsrådgivning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagzeilen stammen aus öffentlichen Quellen. KI-generierte Zusammenfassungen können Fehler enthalten. Keine Anlageberatung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τίτλοι προέρχονται από δημόσιες πηγές. Οι συνόψεις που δημιουργεί το AI μπορεί να είναι ανακριβείς. Δεν αποτελούν επενδυτική συμβουλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headlines come from public sources. AI-generated summaries may be inaccurate. Not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los titulares proceden de fuentes públicas. Los resúmenes de IA pueden contener errores. No es asesoramiento de inversión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pealkirjad pärinevad avalikest allikatest. TI loodud kokkuvõtted võivad olla ebatäpsed. Mitte investeerimisnõu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikot tulevat julkisista lähteistä. Tekoälyn tuottamat tiivistelmät voivat olla epätarkkoja. Ei sijoitusneuvontaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres proviennent de sources publiques. Les résumés générés par l’IA peuvent être inexacts. Ce n’est pas un conseil en investissement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכותרות מגיעות ממקורות ציבוריים. סיכומים שנוצרו על ידי AI עלולים להיות לא מדויקים. אין זו ייעוץ השקעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडलाइन सार्वजनिक स्रोतों से ली गई हैं। AI द्वारा बनाए सारांश गलत हो सकते हैं। यह निवेश सलाह नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi dolaze iz javnih izvora. Sažeci koje generira AI mogu biti netočni. Nisu investicijski savjet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hírcímek nyilvános forrásokból származnak. Az MI által készített összefoglalók pontatlanok lehetnek. Nem minősülnek befektetési tanácsnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berita utama berasal dari sumber publik. Ringkasan buatan AI mungkin tidak akurat. Bukan saran investasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli delle notizie provengono da fonti pubbliche. I riepiloghi generati dall'IA possono contenere errori. Non è una consulenza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出しは公開情報源から取得しています。AIが生成した要約には誤りが含まれる場合があります。投資助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드라인은 공개 출처에서 가져옵니다. AI가 생성한 요약은 부정확할 수 있습니다. 투자 조언이 아닙니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antraštės gaunamos iš viešų šaltinių. DI sukurtos santraukos gali būti netikslios. Tai nėra investicinė konsultacija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virsraksti nāk no publiskiem avotiem. MI ģenerēti kopsavilkumi var būt neprecīzi. Nav ieguldījumu padoms."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk berita datang daripada sumber awam. Ringkasan yang dijana AI mungkin tidak tepat. Bukan nasihat pelaburan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overskrifter kommer fra offentlige kilder. AI-genererte sammendrag kan være unøyaktige. Ikke investeringsråd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppen komen uit openbare bronnen. Door AI gegenereerde samenvattingen kunnen onjuist zijn. Geen beleggingsadvies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagłówki pochodzą z publicznych źródeł. Podsumowania generowane przez AI mogą zawierać błędy. To nie jest porada inwestycyjna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As manchetes vêm de fontes públicas. Os resumos gerados por IA podem conter imprecisões. Não é recomendação de investimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As manchetes vêm de fontes públicas. Os resumos gerados por IA podem conter imprecisões. Não é recomendação de investimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlurile provin din surse publice. Rezumatele generate de AI pot fi inexacte. Nu reprezintă consultanță de investiții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки взяты из открытых источников. Сводки, созданные ИИ, могут быть неточными. Это не инвестиционная рекомендация."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Titulky pochádzajú z verejných zdrojov. Súhrny generované AI môžu byť nepresné. Nejde o investičné poradenstvo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi izvirajo iz javnih virov. Povzetki, ki jih ustvari UI, so lahko netočni. Niso naložbeno svetovanje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi potiču iz javnih izvora. Rezimei koje generiše AI mogu biti netačni. Nisu investicioni savet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubriker kommer från offentliga källor. AI-genererade sammanfattningar kan vara felaktiga. Inte investeringsrådgivning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาดหัวข่าวมาจากแหล่งสาธารณะ สรุปที่สร้างโดย AI อาจไม่ถูกต้อง ไม่ใช่คำแนะนำในการลงทุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar herkese açık kaynaklardan gelir. Yapay zeka özetleri hatalı olabilir. Yatırım tavsiyesi değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки взято з відкритих джерел. Зведення, створені ШІ, можуть бути неточними. Це не інвестиційна порада."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề lấy từ các nguồn công khai. Bản tóm tắt do AI tạo có thể không chính xác. Không phải lời khuyên đầu tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题来自公开来源。AI 生成的摘要可能不准确。不构成投资建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題來自公開來源。AI 產生的摘要可能不準確。非投資建議。"
          }
        }
      }
    },
