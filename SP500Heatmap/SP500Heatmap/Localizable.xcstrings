    "Add stocks to a watchlist to see their news here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أسهماً إلى قائمة المتابعة لعرض أخبارها هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে খবর দেখতে ওয়াচলিস্টে শেয়ার যোগ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add stocks to a watchlist to see their news here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade valores a una lista de seguimiento para ver aquí sus noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des actions à une liste de suivi pour voir ici leurs actualités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ उनकी खबरें देखने के लिए वॉचलिस्ट में शेयर जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте акции в список наблюдения, чтобы видеть здесь их новости."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте акції до списку спостереження, щоб бачити тут їхні новини."
          }
        },
        "zh-Hans": {
