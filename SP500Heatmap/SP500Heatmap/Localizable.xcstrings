    "Base currency can be changed later in the portfolio menu.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير العملة الأساسية لاحقًا من قائمة المحفظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовата валута може да се промени по-късно от менюто на портфейла."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল মুদ্রা পরে পোর্টফোলিও মেনু থেকে বদলানো যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda base es pot canviar més endavant al menú de la cartera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Základní měnu lze později změnit v nabídce portfolia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Basisvalutaen kan ændres senere i porteføljemenuen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Basiswährung kann später im Portfolio-Menü geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βασικό νόμισμα μπορεί να αλλάξει αργότερα από το μενού του χαρτοφυλακίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base currency can be changed later in the portfolio menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La moneda base se puede cambiar después en el menú de la cartera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhivaluutat saab hiljem portfelli menüüs muuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perusvaluuttaa voi muuttaa myöhemmin salkkuvalikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La devise de base peut être modifiée plus tard dans le menu du portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשנות את מטבע הבסיס מאוחר יותר בתפריט התיק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधार मुद्रा बाद में पोर्टफ़ोलियो मेनू में बदली जा सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osnovna valuta može se kasnije promijeniti u izborniku portfelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alappénznem később módosítható a portfólió menüjében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata uang dasar dapat diubah nanti di menu portofolio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La valuta di base può essere cambiata in seguito dal menu del portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準通貨は、あとからポートフォリオのメニューで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 통화는 나중에 포트폴리오 메뉴에서 변경할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazinę valiutą vėliau galima pakeisti portfelio meniu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bāzes valūtu var mainīt vēlāk portfeļa izvēlnē."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata wang asas boleh ditukar kemudian dalam menu portfolio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Basisvalutaen kan endres senere i portefølje-menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De basisvaluta kan later worden gewijzigd in het portefeuillemenu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walutę bazową można później zmienić w menu portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
