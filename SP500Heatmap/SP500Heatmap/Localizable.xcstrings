    "Long history is not available yet - showing 1 year": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السجل الطويل غير متاح بعد، يتم عرض سنة واحدة"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дългата история още не е налична – показва се 1 година"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দীর্ঘ ইতিহাস এখনো পাওয়া যায়নি — ১ বছর দেখানো হচ্ছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historial llarg encara no està disponible: es mostra 1 any"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouhá historie zatím není k dispozici - zobrazuje se 1 rok"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang historik er endnu ikke tilgængelig - viser 1 år"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lange Verlauf ist noch nicht verfügbar – es wird 1 Jahr angezeigt"
