            "value": "Gli avvisi di prezzo vengono controllati in background; iOS decide quando, quindi possono arrivare in ritardo o saltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格アラートはバックグラウンドで確認されます。実行タイミングはiOSが決めるため、遅れたりスキップされたりすることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 알림은 백그라운드에서 확인됩니다. 실행 시점은 iOS가 결정하므로 늦거나 건너뛸 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kainų įspėjimai tikrinami fone; „iOS“ nusprendžia, kada, todėl jie gali vėluoti arba būti praleisti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenu brīdinājumi tiek pārbaudīti fonā; iOS nosaka, kad, tāpēc tie var kavēties vai nenotikt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran harga disemak di latar belakang; iOS yang menentukan bila, jadi ia mungkin lewat atau terlepas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursvarsler sjekkes i bakgrunnen; iOS avgjør når, så de kan bli forsinket eller utebli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koersmeldingen worden op de achtergrond gecontroleerd; iOS bepaalt wanneer, dus ze kunnen vertraagd zijn of ontbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty cenowe są sprawdzane w tle; to iOS decyduje kiedy, więc mogą się opóźniać lub być pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de preço são verificados em segundo plano; o iOS decide quando, então podem atrasar ou ser ignorados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de preço são verificados em segundo plano; o iOS decide quando, então podem atrasar ou ser ignorados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele de preț sunt verificate în fundal; iOS decide când, deci pot întârzia sau pot fi omise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценовые оповещения проверяются в фоне; время решает iOS, поэтому они могут запаздывать или пропускаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenové upozornenia sa kontrolujú na pozadí; kedy, rozhoduje iOS, takže môžu prísť oneskorene alebo sa vynechať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorila o ceni se preverjajo v ozadju; iOS odloča, kdaj, zato lahko zamujajo ali izostanejo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenja o ceni proveravaju se u pozadini; iOS odlučuje kada, pa mogu kasniti ili izostati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursaviseringar kontrolleras i bakgrunden; iOS avgör när, så de kan bli försenade eller utebli."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนราคาจะถูกตรวจสอบในเบื้องหลัง iOS เป็นผู้กำหนดว่าจะทำงานเมื่อใด จึงอาจล่าช้าหรือถูกข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat uyarıları arka planda kontrol edilir; zamanına iOS karar verir, bu yüzden gecikebilir veya atlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цінові сповіщення перевіряються у фоні; час визначає iOS, тому вони можуть запізнюватися або пропускатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo giá được kiểm tra ở chế độ nền; iOS quyết định khi nào chạy, nên có thể bị trễ hoặc bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格提醒在后台检查，时间由 iOS 决定，可能延迟或被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格提醒會在背景檢查；執行時機由 iOS 決定，因此可能延遲或被略過。"
          }
        }
      }
    },
