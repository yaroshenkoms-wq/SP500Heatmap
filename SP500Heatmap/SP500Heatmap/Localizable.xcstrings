    "Company filings (13F) of famous investors come from public SEC data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي ملفات 13F للمستثمرين المشهورين من بيانات SEC العامة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিখ্যাত বিনিয়োগকারীদের 13F ফাইলিং SEC-এর প্রকাশ্য তথ্য থেকে নেওয়া।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
