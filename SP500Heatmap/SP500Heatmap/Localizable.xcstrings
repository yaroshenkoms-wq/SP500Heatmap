          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা"
          }
        },
        "hi": {
