            "value": "היסטוריה ארוכה עדיין אינה זמינה - מוצגת שנה אחת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबा इतिहास अभी उपलब्ध नहीं है — 1 वर्ष दिखाया जा रहा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duga povijest još nije dostupna – prikazuje se 1 godina"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hosszú előzmények még nem érhetők el – 1 év látható"
