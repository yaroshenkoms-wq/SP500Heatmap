    "Some exchange rates are missing; amounts in other currencies are shown unconverted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some exchange rates are missing; amounts in other currencies are shown unconverted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan algunos tipos de cambio; los importes en otras divisas se muestran sin convertir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少部分汇率；其他货币的金额按原值显示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض أسعار الصرف مفقودة؛ تُعرض المبالغ بالعملات الأخرى دون تحويل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains taux de change manquent ; les montants en autres devises sont affichés sans conversion."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু বিনিময় হার নেই; অন্য মুদ্রার অঙ্ক রূপান্তর ছাড়াই দেখানো হচ্ছে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ विनिमय दरें उपलब्ध नहीं; अन्य मुद्राओं की राशियाँ बिना रूपांतरण दिखाई गई हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает некоторых курсов валют; суммы в других валютах показаны без пересчёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракує деяких курсів валют; суми в інших валютах показано без перерахунку."
          }
        }
      }
    },
    "The price is filled from the daily close of that date; you can change it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price is filled from the daily close of that date; you can change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio se rellena con el cierre diario de esa fecha; puedes cambiarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格取自该日期的收盘价，可以修改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُملأ السعر من إغلاق ذلك اليوم؛ يمكنك تغييره."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cours est prérempli avec la clôture de cette date ; vous pouvez le modifier."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দাম ওই তারিখের সমাপনী মূল্য থেকে ভরা হয়; আপনি বদলাতে পারেন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य उस तारीख के समापन भाव से भरा जाता है; आप इसे बदल सकते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена подставляется по закрытию этого дня; её можно изменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна підставляється за закриттям цього дня; її можна змінити."
          }
        }
      }
    },
    "This portfolio is too large for iCloud sync and is kept on this device only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This portfolio is too large for iCloud sync and is kept on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cartera es demasiado grande para iCloud y se guarda solo en este dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此投资组合过大，无法通过 iCloud 同步，仅保存在本设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المحفظة أكبر من أن تُزامن عبر iCloud وتبقى على هذا الجهاز فقط."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portefeuille est trop volumineux pour iCloud et reste uniquement sur cet appareil."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোর্টফোলিও iCloud সিঙ্কের জন্য খুব বড়; এটি শুধু এই ডিভাইসে থাকবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पोर्टफ़ोलियो iCloud सिंक के लिए बहुत बड़ा है और केवल इसी डिवाइस पर रहेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Портфель слишком большой для iCloud и хранится только на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Портфель завеликий для iCloud і зберігається лише на цьому пристрої."
          }
        }
      }
    },
