    "Add buys, sells and dividends to see value, profit, allocation and performance against an index.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عمليات الشراء والبيع والأرباح لعرض القيمة والربح والتوزيع والأداء مقابل مؤشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য, লাভ, বণ্টন এবং সূচকের তুলনায় পারফরম্যান্স দেখতে ক্রয়, বিক্রয় ও লভ্যাংশ যোগ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add buys, sells and dividends to see value, profit, allocation and performance against an index."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade compras, ventas y dividendos para ver valor, beneficio, distribución y rentabilidad frente a un índice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez achats, ventes et dividendes pour voir la valeur, le gain, la répartition et la performance face à un indice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य, लाभ, आवंटन और इंडेक्स के मुकाबले प्रदर्शन देखने के लिए खरीद, बिक्री और लाभांश जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте покупки, продажи и дивиденды, чтобы увидеть стоимость, прибыль, структуру и доходность в сравнении с индексом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте купівлі, продажі та дивіденди, щоб побачити вартість, прибуток, структуру й дохідність порівняно з індексом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加买入、卖出和股息，即可查看市值、收益、配置以及相对指数的表现。"
          }
        }
      }
    },
