    "Add transactions in the Portfolio tab first, then I can summarize it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عمليات في تبويب المحفظة أولاً، ثم يمكنني تلخيصها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първо добавете транзакции в раздел Портфейл, след което мога да го обобщя."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে পোর্টফোলিও ট্যাবে লেনদেন যোগ করুন, তারপর আমি সারাংশ দিতে পারব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix primer operacions a la pestanya Cartera i després podré fer-ne un resum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív přidejte transakce na kartě Portfolio, pak je budu moci shrnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj først transaktioner under fanen Portefølje, så kan jeg opsummere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst im Tab „Portfolio“ Transaktionen hinzu, dann kann ich es zusammenfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε πρώτα συναλλαγές στην καρτέλα Χαρτοφυλάκιο και μετά μπορώ να το συνοψίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add transactions in the Portfolio tab first, then I can summarize it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade operaciones en la pestaña Cartera y después podré resumirla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa esmalt tehingud vahekaardil Portfell, siis saan selle kokku võtta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensin tapahtumia Salkku-välilehdellä, niin voin tehdä yhteenvedon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord des opérations dans l’onglet Portefeuille, puis je pourrai le résumer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו קודם עסקאות בלשונית תיק ההשקעות, ואז אוכל לסכם אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले पोर्टफ़ोलियो टैब में लेन-देन जोड़ें, फिर मैं सारांश दे सकूँगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo dodajte transakcije na kartici Portfelj, tada ga mogu sažeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először adjon hozzá tranzakciókat a Portfólió fülön, utána össze tudom foglalni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan transaksi di tab Portofolio terlebih dahulu, lalu saya bisa meringkasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima delle operazioni nella scheda Portafoglio, poi potrò riassumerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず「ポートフォリオ」タブで取引を追加してください。その後に要約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 포트폴리오 탭에서 거래를 추가해 주세요. 그러면 요약해 드릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirmiausia pridėkite sandorių skiltyje Portfelis, tada galėsiu jį apibendrinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vispirms pievienojiet darījumus cilnē Portfelis, tad es varēšu veikt kopsavilkumu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah transaksi dalam tab Portfolio dahulu, kemudian saya boleh meringkaskannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg først til transaksjoner i fanen Portefølje, så kan jeg oppsummere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst transacties toe in het tabblad Portefeuille, dan kan ik het samenvatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj transakcje w zakładce Portfel, wtedy będę mógł je podsumować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione transações na aba Carteira primeiro; depois posso resumi-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione transações na separador Carteira primeiro; depois posso resumi-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă mai întâi tranzacții în fila Portofoliu, apoi pot face un rezumat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте сделки на вкладке «Портфель», тогда я смогу сделать сводку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv pridajte transakcie na karte Portfólio, potom ich budem môcť zhrnúť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej dodajte transakcije na zavihku Portfelj, nato ga lahko povzamem."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo dodajte transakcije na kartici Portfolio, pa ga mogu sažeti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg först till transaktioner på fliken Portfölj, så kan jag sammanfatta den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรายการซื้อขายในแท็บพอร์ตก่อน จากนั้นฉันจะสรุปให้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Portföy sekmesinde işlem ekleyin, sonra özetleyebilirim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу додайте угоди на вкладці «Портфель», тоді я зможу зробити зведення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thêm giao dịch trong tab Danh mục trước, sau đó tôi có thể tóm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“投资组合”标签中添加交易，之后我才能为您总结。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「投資組合」分頁新增交易，我才能為您摘要。"
          }
        }
      }
    },
    "Add your first buy, or import a CSV file (date,type,ticker,quantity,price,currency,fee).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أول عملية شراء أو استورد ملف CSV (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете първата си покупка или импортирайте CSV файл (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম ক্রয় যোগ করুন বা CSV ফাইল আমদানি করুন (date,type,ticker,quantity,price,currency,fee)।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix la teva primera compra o importa un fitxer CSV (data,tipus,ticker,quantitat,preu,moneda,comissió)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte první nákup nebo importujte soubor CSV (datum,typ,ticker,množství,cena,měna,poplatek)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj dit første køb, eller importér en CSV-fil (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen ersten Kauf hinzu oder importiere eine CSV-Datei (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε την πρώτη σας αγορά ή εισαγάγετε αρχείο CSV (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first buy, or import a CSV file (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primera compra o importa un archivo CSV (date,type,ticker,quantity,price,currency,fee)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
