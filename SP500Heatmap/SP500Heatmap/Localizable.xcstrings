    "Allow Live Activities for this app in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالأنشطة المباشرة لهذا التطبيق في إعدادات iOS."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете Live Activities за това приложение в настройките на iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে এই অ্যাপের জন্য লাইভ অ্যাক্টিভিটি অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet les Activitats en directe d'aquesta app a Configuració d'iOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte pro tuto aplikaci Živé aktivity v Nastavení iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Live Activities for denne app i iOS-indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Live-Aktivitäten für diese App in den iOS-Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε τις Ζωντανές Δραστηριότητες για αυτή την εφαρμογή στις Ρυθμίσεις του iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Live Activities for this app in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las actividades en directo de esta app en Ajustes de iOS."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba selle rakenduse Live Activities iOS-i seadetes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli tämän sovelluksen Live Activities iOS:n asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les activités en direct pour cette app dans les Réglages iOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו פעילויות חיות לאפליקציה זו בהגדרות iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में इस ऐप के लिए लाइव एक्टिविटी की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite Live Activities za ovu aplikaciju u postavkama iOS-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze az Élő tevékenységeket ehhez az alkalmazáshoz az iOS Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Live Activities untuk aplikasi ini di Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le Attività Live per questa app nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定でこのアプリのライブアクティビティを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 이 앱의 실시간 현황(Live Activity)을 허용해 주세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiskite šiai programėlei naudoti tiesioginę veiklą „iOS“ nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļaujiet šīs lietotnes Live Activities iOS iestatījumos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Live Activities untuk apl ini dalam Tetapan iOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Live Activities for denne appen i iOS-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Live Activities voor deze app toe in de iOS-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tej aplikacji na Aktywności na żywo w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita Atividades ao Vivo para este app nos Ajustes do iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita Atividades em Direto para este app nos Definições do iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Activitățile live pentru această aplicație din Setările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Live Activities для этого приложения в настройках iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte pre túto aplikáciu Živé aktivity v Nastaveniach iOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavitvah iOS dovolite Žive aktivnosti za to aplikacijo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite Live Activities za ovu aplikaciju u podešavanjima iOS-a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Live Activities för den här appen i iOS-inställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาต Live Activities สำหรับแอปนี้ในการตั้งค่า iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlarında bu uygulama için Canlı Etkinliklere izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Live Activities для цього застосунку в налаштуваннях iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép Live Activities cho ứng dụng này trong Cài đặt iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中允许此应用使用实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iOS 設定中允許此 App 使用即時動態。"
          }
        }
      }
    },
    "Allow notifications for this app in iOS Settings to get alerts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالإشعارات لهذا التطبيق من إعدادات iOS لتلقي التنبيهات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете известията за това приложение в настройките на iOS, за да получавате известия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা পেতে iOS সেটিংসে এই অ্যাপের বিজ্ঞপ্তি অনুমোদন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet les notificacions d'aquesta app a Configuració d'iOS per rebre avisos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte pro tuto aplikaci oznámení v Nastavení iOS, abyste dostávali upozornění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad notifikationer for denne app i iOS-indstillinger for at få alarmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen für diese App in den iOS-Einstellungen, um Alarme zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε τις ειδοποιήσεις για αυτή την εφαρμογή στις Ρυθμίσεις του iOS για να λαμβάνετε ειδοποιήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for this app in iOS Settings to get alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones de esta app en los Ajustes de iOS para recibir alertas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba selle rakenduse teavitused iOS-i seadetes, et saada teavitusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli tämän sovelluksen ilmoitukset iOS:n asetuksissa saadaksesi hälytyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications de cette app dans les Réglages iOS pour recevoir des alertes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו התראות לאפליקציה זו בהגדרות iOS כדי לקבל התראות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट पाने के लिए iOS सेटिंग्स में इस ऐप की सूचनाएँ अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite obavijesti za ovu aplikaciju u postavkama iOS-a kako biste primali upozorenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze az értesítéseket ehhez az alkalmazáshoz az iOS Beállításokban, hogy értesítéseket kapjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan notifikasi untuk aplikasi ini di Pengaturan iOS untuk menerima peringatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche per questa app nelle Impostazioni di iOS per ricevere gli avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラートを受け取るには、iOSの設定でこのアプリの通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 받으려면 iOS 설정에서 이 앱의 알림을 허용해 주세요."
