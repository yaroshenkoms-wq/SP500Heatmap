    "That date is too close or already passed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التاريخ قريب جدًا أو مضى بالفعل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখটি খুব কাছে বা পেরিয়ে গেছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
