    "Open a company and tap the star, or long-press a tile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح شركة واضغط على النجمة، أو اضغط مطولاً على مربع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কোম্পানি খুলে তারা চাপুন, অথবা কোনো টাইলে দীর্ঘক্ষণ চেপে ধরুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a company and tap the star, or long-press a tile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una empresa y toca la estrella, o mantén pulsado un recuadro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une entreprise et touchez l’étoile, ou appuyez longuement sur une tuile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कंपनी को खोलें और तारे पर टैप करें, या किसी टाइल को देर तक दबाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте компанию и нажмите звезду или удерживайте плитку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте компанію та натисніть зірку або утримуйте плитку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一家公司并点按星标，或长按方块。"
          }
        }
      }
    },
