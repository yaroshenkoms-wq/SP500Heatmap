    },
    "Price alerts are checked in the background. iOS decides when that runs, so they may be delayed or skipped. Earnings and dividend reminders are exact.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص تنبيهات الأسعار في الخلفية، ويقرر iOS وقت ذلك، لذا قد تتأخر أو تُتجاوز. أما تذكيرات الأرباح والتوزيعات فدقيقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценовите известия се проверяват във фонов режим. iOS решава кога се изпълнява това, затова може да закъснеят или да бъдат пропуснати. Напомнянията за резултати и дивиденти са точни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য সতর্কতা ব্যাকগ্রাউন্ডে যাচাই হয়। কখন চলবে তা iOS ঠিক করে, তাই দেরি হতে বা বাদ পড়তে পারে। আয় ও লভ্যাংশের অনুস্মারক ঠিক সময়ে আসে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els avisos de preu es comproven en segon pla. iOS decideix quan s'executa, de manera que poden endarrerir-se o ometre's. Els recordatoris de resultats i dividends són exactes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenová upozornění se kontrolují na pozadí. Kdy se to děje, rozhoduje iOS, takže mohou přijít se zpožděním nebo vynechat. Připomínky výsledků a dividend jsou přesné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursalarmer kontrolleres i baggrunden. iOS bestemmer, hvornår det sker, så de kan blive forsinket eller udeblive. Påmindelser om regnskab og udbytte er præcise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursalarme werden im Hintergrund geprüft. iOS entscheidet, wann das geschieht, daher können sie verzögert kommen oder ausfallen. Erinnerungen zu Quartalszahlen und Dividenden sind genau."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις τιμής ελέγχονται στο παρασκήνιο. Το iOS αποφασίζει πότε εκτελείται ο έλεγχος, γι’ αυτό μπορεί να καθυστερήσουν ή να παραλειφθούν. Οι υπενθυμίσεις αποτελεσμάτων και μερισμάτων είναι ακριβείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price alerts are checked in the background. iOS decides when that runs, so they may be delayed or skipped. Earnings and dividend reminders are exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas de precio se comprueban en segundo plano. iOS decide cuándo, así que pueden retrasarse u omitirse. Los recordatorios de resultados y dividendos son exactos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnateavitusi kontrollitakse taustal. iOS otsustab, millal see juhtub, seega võivad need hilineda või ära jääda. Tulemuste ja dividendide meeldetuletused on täpsed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintahälytykset tarkistetaan taustalla. iOS päättää, milloin se tapahtuu, joten ne voivat viivästyä tai jäädä tulematta. Tulos- ja osinkomuistutukset ovat tarkkoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes de prix sont vérifiées en arrière-plan. iOS décide du moment, elles peuvent donc être retardées ou manquées. Les rappels de résultats et de dividendes sont exacts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות מחיר נבדקות ברקע. iOS קובעת מתי הבדיקה רצה, ולכן הן עלולות להתעכב או להידלג. תזכורות לדוחות ולדיבידנדים מדויקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाव अलर्ट बैकग्राउंड में जाँचे जाते हैं। कब चलेंगे यह iOS तय करता है, इसलिए देरी हो सकती है या छूट सकते हैं। नतीजों और लाभांश के रिमाइंडर सटीक समय पर आते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenja o cijeni provjeravaju se u pozadini. iOS odlučuje kada se to pokreće, pa mogu kasniti ili izostati. Podsjetnici za rezultate i dividende su točni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az árriasztásokat a háttérben ellenőrizzük. Hogy ez mikor fut le, azt az iOS dönti el, ezért késhetnek vagy kimaradhatnak. Az eredmény- és osztalék-emlékeztetők pontosak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan harga diperiksa di latar belakang. iOS yang menentukan kapan itu berjalan, sehingga bisa tertunda atau terlewat. Pengingat laba dan dividen tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi di prezzo vengono controllati in background. iOS decide quando, quindi possono arrivare in ritardo o saltare. I promemoria su utili e dividendi sono puntuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格アラートはバックグラウンドで確認されます。実行タイミングはiOSが決めるため、遅れたりスキップされたりすることがあります。決算と配当のリマインダーは正確です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 알림은 백그라운드에서 확인됩니다. 실행 시점은 iOS가 결정하므로 늦거나 건너뛸 수 있습니다. 실적 및 배당 알림은 정확합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kainų įspėjimai tikrinami fone. „iOS“ nusprendžia, kada tai vyksta, todėl jie gali vėluoti arba būti praleisti. Priminimai apie rezultatus ir dividendus yra tikslūs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenu brīdinājumi tiek pārbaudīti fonā. iOS nosaka, kad tas notiek, tāpēc tie var kavēties vai nenotikt. Atgādinājumi par rezultātiem un dividendēm ir precīzi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran harga disemak di latar belakang. iOS yang menentukan bila ia dijalankan, jadi ia mungkin lewat atau terlepas. Peringatan pendapatan dan dividen tepat pada masanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursvarsler sjekkes i bakgrunnen. iOS avgjør når det skjer, så de kan bli forsinket eller utebli. Påminnelser om regnskap og utbytte er nøyaktige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koersmeldingen worden op de achtergrond gecontroleerd. iOS bepaalt wanneer dat gebeurt, dus ze kunnen vertraagd zijn of ontbreken. Herinneringen voor winstcijfers en dividenden zijn exact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty cenowe są sprawdzane w tle. To iOS decyduje, kiedy to się dzieje, więc mogą się opóźniać lub być pomijane. Przypomnienia o wynikach i dywidendach są dokładne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de preço são verificados em segundo plano. O iOS decide quando isso ocorre, então podem atrasar ou ser ignorados. Os lembretes de resultados e dividendos são exatos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de preço são verificados em segundo plano. O iOS decide quando isso ocorre, então podem atrasar ou ser ignorados. Os lembretes de resultados e dividendos são exatos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele de preț sunt verificate în fundal. iOS decide când se întâmplă asta, deci pot întârzia sau pot fi omise. Mementourile pentru rezultate și dividende sunt exacte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценовые оповещения проверяются в фоне. Когда это происходит, решает iOS, поэтому они могут запаздывать или пропускаться. Напоминания об отчётности и дивидендах точные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenové upozornenia sa kontrolujú na pozadí. Kedy sa to deje, rozhoduje iOS, takže môžu prísť oneskorene alebo sa vynechať. Pripomienky výsledkov a dividend sú presné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opozorila o ceni se preverjajo v ozadju. iOS odloča, kdaj se to izvede, zato lahko zamujajo ali izostanejo. Opomniki za rezultate in dividende so natančni."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorenja o ceni proveravaju se u pozadini. iOS odlučuje kada se to pokreće, pa mogu kasniti ili izostati. Podsetnici za rezultate i dividende su tačni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursaviseringar kontrolleras i bakgrunden. iOS avgör när det sker, så de kan bli försenade eller utebli. Påminnelser om rapporter och utdelningar är exakta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนราคาจะถูกตรวจสอบในเบื้องหลัง iOS เป็นผู้กำหนดว่าจะทำงานเมื่อใด จึงอาจล่าช้าหรือถูกข้าม ส่วนการเตือนงบและเงินปันผลตรงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyat uyarıları arka planda kontrol edilir. Ne zaman çalışacağına iOS karar verir; bu yüzden gecikebilir veya atlanabilir. Bilanço ve temettü hatırlatmaları tam zamanında gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цінові сповіщення перевіряються у фоні. Коли саме, вирішує iOS, тому вони можуть запізнюватися або пропускатися. Нагадування про звітність і дивіденди точні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo giá được kiểm tra ở chế độ nền. iOS quyết định khi nào chạy, nên có thể bị trễ hoặc bỏ qua. Nhắc nhở kết quả kinh doanh và cổ tức thì chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格提醒在后台检查，运行时间由 iOS 决定，因此可能延迟或被跳过。财报和股息提醒则准时送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格提醒會在背景檢查。執行時機由 iOS 決定，因此可能延遲或被略過。財報與股息提醒則準時發送。"
          }
        }
      }
    },
