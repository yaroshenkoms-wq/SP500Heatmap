    "Prices are daily closes and may be delayed. Currency conversion uses daily exchange rates. Not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار هي إغلاقات يومية وقد تتأخر. يستخدم تحويل العملات أسعار صرف يومية. ليست نصيحة استثمارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দাম প্রতিদিনের সমাপনী মূল্য এবং দেরিতে আসতে পারে। মুদ্রা রূপান্তরে দৈনিক বিনিময় হার ব্যবহৃত হয়। এটি বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are daily closes and may be delayed. Currency conversion uses daily exchange rates. Not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios son cierres diarios y pueden tener retraso. La conversión de divisas usa tipos de cambio diarios. No es asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours sont des clôtures quotidiennes et peuvent être différés. La conversion utilise les taux de change quotidiens. Ne constitue pas un conseil en investissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य दैनिक समापन भाव हैं और देरी से आ सकते हैं। मुद्रा रूपांतरण दैनिक विनिमय दरों पर आधारित है। यह निवेश सलाह नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены — дневные закрытия, возможна задержка. Пересчёт валют идёт по дневным курсам. Не является инвестиционной рекомендацией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни — денні закриття, можлива затримка. Перерахунок валют ідеться за денними курсами. Не є інвестиційною порадою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格为每日收盘价，可能有延迟。货币换算使用每日汇率。不构成投资建议。"
          }
        }
      }
    },
    "Prices are the last close; the S&P 500 may show live prices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار هي آخر إغلاق؛ وقد يعرض S&P 500 أسعارًا مباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দামগুলো শেষ ক্লোজিং; S&P 500-এ লাইভ দাম দেখাতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are the last close; the S&P 500 may show live prices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios son el último cierre; el S&P 500 puede mostrar precios en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours sont la dernière clôture ; le S&P 500 peut afficher des cours en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतें पिछला बंद भाव हैं; S&P 500 लाइव कीमतें दिखा सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены — последнее закрытие; для S&P 500 могут показываться live-цены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни — останнє закриття; для S&P 500 можуть показуватись live-ціни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格为最近收盘价；标普500可能显示实时价格。"
          }
        }
      }
    },
    "Prices may be delayed. This app is for information only and is not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتأخر الأسعار. هذا التطبيق للمعلومات فقط وليس نصيحة استثمارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দাম দেরিতে আসতে পারে। এই অ্যাপ শুধু তথ্যের জন্য, এটি বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices may be delayed. This app is for information only and is not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios pueden tener retraso. Esta app es solo informativa y no constituye asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours peuvent être différés. Cette app est donnée à titre informatif et ne constitue pas un conseil en investissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतों में देरी हो सकती है। यह ऐप केवल जानकारी के लिए है और निवेश सलाह नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены могут быть с задержкой. Приложение носит информационный характер и не является инвестиционной рекомендацией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни можуть бути із запізненням. Застосунок має інформаційний характер і не є інвестиційною порадою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格可能有延迟。本应用仅供参考，不构成投资建议。"
          }
        }
      }
    },
    "Push active": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات الفورية مفعّلة"
          }
        },
