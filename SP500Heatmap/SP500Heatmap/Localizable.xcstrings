    "Dates come from company reports and may change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواريخ من تقارير الشركات وقد تتغير."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Датите идват от отчетите на компаниите и може да се променят."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখগুলো কোম্পানির প্রতিবেদন থেকে নেওয়া এবং বদলাতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates provenen dels informes de les empreses i poden canviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pocházejí z hlášení společností a mohou se změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoer stammer fra virksomhedsrapporter og kan ændre sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine stammen aus Unternehmensberichten und können sich ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ημερομηνίες προέρχονται από τις εκθέσεις των εταιρειών και ενδέχεται να αλλάξουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates come from company reports and may change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas proceden de las empresas y pueden cambiar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuupäevad pärinevad ettevõtete aruannetest ja võivad muutuda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivämäärät perustuvat yhtiöiden raportteihin ja voivat muuttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates viennent des sociétés et peuvent changer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאריכים מגיעים מדוחות החברות ועשויים להשתנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीखें कंपनी रिपोर्ट से हैं और बदल सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumi dolaze iz izvješća tvrtki i mogu se promijeniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dátumok a vállalati jelentésekből származnak, és változhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal berasal dari laporan perusahaan dan dapat berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date provengono dai report delle aziende e possono cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は企業の発表に基づくもので、変更される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 기업 보고서에 따른 것이며 변경될 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos gaunamos iš įmonių ataskaitų ir gali keistis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumi nāk no uzņēmumu pārskatiem un var mainīties."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarikh datang daripada laporan syarikat dan mungkin berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoer kommer fra selskapsrapporter og kan endre seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data komen uit bedrijfsrapporten en kunnen veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daty pochodzą z raportów spółek i mogą się zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas vêm dos relatórios das empresas e podem mudar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas vêm dos relatórios das empresas e podem mudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele provin din rapoartele companiilor și se pot schimba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты взяты из отчётов компаний и могут измениться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátumy pochádzajú z hlásení spoločností a môžu sa zmeniť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumi izvirajo iz poročil podjetij in se lahko spremenijo."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Datumi potiču iz izveštaja kompanija i mogu se promeniti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum kommer från företagsrapporter och kan ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่มาจากรายงานของบริษัทและอาจเปลี่ยนแปลงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihler şirket raporlarından gelir ve değişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дати взято зі звітів компаній, вони можуть змінитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày lấy từ báo cáo của công ty và có thể thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期来自公司公告，可能会变动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期來自公司財報，可能會變動。"
