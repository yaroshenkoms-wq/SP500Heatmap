    "Alerts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنبيهات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒"
          }
        }
      }
    },
    "Alerts are checked in the background. iOS decides when that runs, so alerts may be delayed or skipped, especially if the app has not been opened for a while.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم فحص التنبيهات في الخلفية. يقرر iOS متى يتم ذلك، لذا قد تتأخر التنبيهات أو تُتجاوز، خاصة إذا لم يُفتح التطبيق منذ فترة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা ব্যাকগ্রাউন্ডে যাচাই হয়। কখন চলবে তা iOS ঠিক করে, তাই সতর্কতা দেরিতে আসতে পারে বা বাদ যেতে পারে, বিশেষ করে অ্যাপ অনেকদিন না খুললে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are checked in the background. iOS decides when that runs, so alerts may be delayed or skipped, especially if the app has not been opened for a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas se comprueban en segundo plano. iOS decide cuándo se ejecuta, así que pueden retrasarse u omitirse, sobre todo si hace tiempo que no abres la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont vérifiées en arrière-plan. iOS décide du moment, elles peuvent donc être retardées ou manquées, surtout si l’app n’a pas été ouverte depuis un moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट बैकग्राउंड में जाँचे जाते हैं। यह कब चलेगा, यह iOS तय करता है, इसलिए अलर्ट देर से आ सकते हैं या छूट सकते हैं, खासकर अगर ऐप कुछ समय से नहीं खोला गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения проверяются в фоне. Когда это происходит, решает iOS, поэтому они могут приходить с задержкой или пропускаться, особенно если приложение давно не открывали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення перевіряються у фоні. Коли це відбувається, вирішує iOS, тож вони можуть приходити із запізненням або пропускатися, особливо якщо застосунок давно не відкривали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒在后台检查。何时运行由 iOS 决定，因此提醒可能延迟或被跳过，尤其是在一段时间没有打开应用时。"
          }
        }
      }
    },
    "Alerts are checked in the background. iOS decides when that runs, so alerts may be delayed or skipped, especially if the app has not been opened for a while. News alerts need push.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص التنبيهات في الخلفية. يقرر iOS وقت ذلك، لذا قد تتأخر أو تُتجاوز، خاصة إذا لم تفتح التطبيق منذ فترة. تنبيهات الأخبار تتطلب الإشعارات الفورية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ট ব্যাকগ্রাউন্ডে যাচাই হয়। কখন চলবে তা iOS ঠিক করে, তাই দেরি হতে পারে বা বাদ যেতে পারে, বিশেষত অ্যাপ অনেক দিন না খুললে। খবরের অ্যালার্টের জন্য পুশ দরকার।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are checked in the background. iOS decides when that runs, so alerts may be delayed or skipped, especially if the app has not been opened for a while. News alerts need push."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas se comprueban en segundo plano. iOS decide cuándo, así que pueden retrasarse u omitirse, sobre todo si no abres la app desde hace tiempo. Las alertas de noticias requieren push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont vérifiées en arrière-plan. iOS décide du moment : elles peuvent être retardées ou ignorées, surtout si l'app n'a pas été ouverte depuis un moment. Les alertes d'actualités nécessitent le push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट बैकग्राउंड में जाँचे जाते हैं। यह कब चलेगा, iOS तय करता है, इसलिए अलर्ट देर से आ सकते हैं या छूट सकते हैं, खासकर अगर ऐप काफ़ी समय से नहीं खुला। खबरों के अलर्ट के लिए पुश ज़रूरी है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения проверяются в фоне. Когда это происходит, решает iOS, поэтому они могут опаздывать или пропускаться, особенно если приложение давно не открывали. Для новостей нужен push."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення перевіряються у фоні. Коли це відбувається, вирішує iOS, тому вони можуть запізнюватися або пропускатися, особливо якщо застосунок давно не відкривали. Для новин потрібен push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒在后台检查。运行时间由 iOS 决定，因此提醒可能延迟或被跳过，尤其是长时间未打开应用时。新闻提醒需要推送。"
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكل"
          }
        },
