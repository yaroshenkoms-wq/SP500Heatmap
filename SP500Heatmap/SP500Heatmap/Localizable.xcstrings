    "Analyst opinions are not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آراء المحللين ليست نصيحة استثمارية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мненията на анализаторите не са инвестиционен съвет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্লেষকদের মতামত বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opinions dels analistes no són assessorament d'inversió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názory analytiků nejsou investiční poradenství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytikeres udtalelser er ikke investeringsrådgivning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analystenmeinungen sind keine Anlageberatung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απόψεις των αναλυτών δεν αποτελούν επενδυτική συμβουλή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyst opinions are not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opiniones de analistas no son asesoramiento de inversión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Analüütikute arvamused ei ole investeerimisnõu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyytikoiden mielipiteet eivät ole sijoitusneuvontaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avis d'analystes ne sont pas des conseils en investissement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוות דעת של אנליסטים אינן ייעוץ השקעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषकों की राय निवेश सलाह नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mišljenja analitičara nisu investicijski savjet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemzői vélemények nem minősülnek befektetési tanácsnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendapat analis bukan saran investasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pareri degli analisti non sono consulenza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アナリストの意見は投資助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애널리스트 의견은 투자 조언이 아닙니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analitikų nuomonės nėra investicinė konsultacija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analītiķu viedokļi nav ieguldījumu padoms."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendapat penganalisis bukan nasihat pelaburan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytikeres meninger er ikke investeringsråd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningen van analisten zijn geen beleggingsadvies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opinie analityków nie są poradą inwestycyjną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opiniões de analistas não são recomendação de investimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As opiniões de analistas não são recomendação de investimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opiniile analiștilor nu reprezintă consultanță de investiții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мнения аналитиков не являются инвестиционной рекомендацией."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názory analytikov nie sú investičné poradenstvo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnenja analitikov niso naložbeno svetovanje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mišljenja analitičara nisu investicioni savet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytikers åsikter är inte investeringsrådgivning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเห็นของนักวิเคราะห์ไม่ใช่คำแนะนำในการลงทุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analist görüşleri yatırım tavsiyesi değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Думки аналітиків не є інвестиційною порадою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ý kiến của nhà phân tích không phải lời khuyên đầu tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析师观点不构成投资建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析師意見不構成投資建議。"
          }
        }
      }
    },
