    "Some exchange rates are missing; amounts in other currencies are shown unconverted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض أسعار الصرف مفقودة؛ تُعرض المبالغ بالعملات الأخرى دون تحويل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Липсват някои обменни курсове; сумите в други валути се показват без конвертиране."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু বিনিময় হার নেই; অন্য মুদ্রার অঙ্ক রূপান্তর ছাড়াই দেখানো হচ্ছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Falten alguns tipus de canvi; els imports en altres monedes es mostren sense convertir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí některé směnné kurzy; částky v jiných měnách se zobrazují bez přepočtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle valutakurser mangler; beløb i andre valutaer vises uden omregning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Wechselkurse fehlen; Beträge in anderen Währungen werden unkonvertiert angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λείπουν ορισμένες ισοτιμίες· τα ποσά σε άλλα νομίσματα εμφανίζονται χωρίς μετατροπή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some exchange rates are missing; amounts in other currencies are shown unconverted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan algunos tipos de cambio; los importes en otras divisas se muestran sin convertir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõned vahetuskursid puuduvad; muudes valuutades summad kuvatakse ümberarvutamata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joitakin valuuttakursseja puuttuu; muissa valuutoissa olevat summat näytetään muuntamattomina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains taux de change manquent ; les montants en autres devises sont affichés sans conversion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק משערי החליפין חסרים; סכומים במטבעות אחרים מוצגים ללא המרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ विनिमय दरें उपलब्ध नहीं; अन्य मुद्राओं की राशियाँ बिना रूपांतरण दिखाई गई हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki tečajevi nedostaju; iznosi u drugim valutama prikazani su bez pretvorbe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány árfolyam hiányzik; a más pénznemű összegek átváltás nélkül láthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa kurs tidak tersedia; jumlah dalam mata uang lain ditampilkan tanpa konversi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano alcuni tassi di cambio; gli importi in altre valute sono mostrati senza conversione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の為替レートがありません。他通貨の金額は換算されずに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 환율이 없어 다른 통화의 금액은 환산하지 않고 표시합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trūksta kai kurių valiutų kursų; kitomis valiutomis išreikštos sumos rodomos nekonvertuotos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažu valūtu kursu trūkst; summas citās valūtās tiek rādītas nekonvertētas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah kadar pertukaran tiada; jumlah dalam mata wang lain dipaparkan tanpa penukaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen valutakurser mangler; beløp i andre valutaer vises uten omregning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige wisselkoersen ontbreken; bedragen in andere valuta’s worden niet omgerekend getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje niektórych kursów walut; kwoty w innych walutach są pokazane bez przeliczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas taxas de câmbio estão ausentes; valores em outras moedas são exibidos sem conversão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas taxas de câmbio estão ausentes; valores em outras moedas são apresentados sem conversão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipsesc unele cursuri de schimb; sumele în alte monede sunt afișate neconvertite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает некоторых курсов валют; суммы в других валютах показаны без пересчёта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chýbajú niektoré výmenné kurzy; sumy v iných menách sa zobrazujú bez prepočtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekateri menjalni tečaji manjkajo; zneski v drugih valutah so prikazani brez pretvorbe."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki kursevi nedostaju; iznosi u drugim valutama prikazani su bez konverzije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa växelkurser saknas; belopp i andra valutor visas oomräknade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาดอัตราแลกเปลี่ยนบางสกุล จำนวนเงินในสกุลอื่นจะแสดงโดยไม่แปลงค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı döviz kurları eksik; diğer para birimlerindeki tutarlar çevrilmeden gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракує деяких курсів валют; суми в інших валютах показано без перерахунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu một số tỷ giá; số tiền ở các loại tiền khác được hiển thị chưa quy đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少部分汇率；其他货币的金额按原值显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分匯率缺漏，其他貨幣的金額將以未換算方式顯示。"
          }
        }
      }
    },
