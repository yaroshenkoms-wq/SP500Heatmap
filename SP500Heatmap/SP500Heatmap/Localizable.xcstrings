    "Markets are mixed today.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسواق متباينة اليوم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазарите са смесени днес."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ বাজার মিশ্র।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avui els mercats van mixtos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trhy jsou dnes smíšené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markederne er blandede i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Märkte sind heute uneinheitlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγορές είναι μικτές σήμερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markets are mixed today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mercados están mixtos hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Turud on täna segased."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Markkinat ovat tänään vaihtelevat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les marchés sont mitigés aujourd’hui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השווקים מעורבים היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज बाज़ार मिले-जुले हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tržišta su danas mješovita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A piacok ma vegyesek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar bervariasi hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi i mercati sono contrastati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の市場はまちまちです。"
