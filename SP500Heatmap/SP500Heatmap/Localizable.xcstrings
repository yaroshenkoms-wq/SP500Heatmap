    "Company filings (13F) of famous investors come from public SEC data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي ملفات 13F للمستثمرين المشهورين من بيانات SEC العامة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Декларациите на компании (13F) на известни инвеститори идват от публични данни на SEC."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিখ্যাত বিনিয়োগকারীদের 13F ফাইলিং SEC-এর প্রকাশ্য তথ্য থেকে নেওয়া।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les declaracions (13F) d'inversors famosos provenen de dades públiques de la SEC."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlášení (13F) slavných investorů pocházejí z veřejných dat SEC."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendte investorers beholdninger (13F) stammer fra offentlige SEC-data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meldungen (13F) bekannter Investoren stammen aus öffentlichen SEC-Daten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καταθέσεις εταιρειών (13F) γνωστών επενδυτών προέρχονται από δημόσια δεδομένα της SEC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company filings (13F) of famous investors come from public SEC data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes 13F de inversores famosos proceden de datos públicos de la SEC."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuntud investorite hoiused (13F) pärinevad avalikest SEC-i andmetest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnettujen sijoittajien omistukset (13F) perustuvat julkisiin SEC-tietoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépôts 13F d'investisseurs célèbres proviennent des données publiques de la SEC."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווחי החברות (13F) של משקיעים מפורסמים מגיעים מנתונים ציבוריים של ה-SEC."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रसिद्ध निवेशकों की 13F फाइलिंग SEC के सार्वजनिक डेटा से ली गई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijave tvrtki (13F) poznatih investitora dolaze iz javnih podataka SEC-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A híres befektetők cégbejelentései (13F) nyilvános SEC-adatokból származnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan perusahaan (13F) milik investor ternama berasal dari data publik SEC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dichiarazioni (13F) dei grandi investitori provengono da dati pubblici della SEC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "著名投資家の企業提出書類（13F）は、SECの公開データに基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유명 투자자의 기업 보고서(13F)는 SEC 공개 데이터에서 가져옵니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žinomų investuotojų įmonių ataskaitos (13F) gaunamos iš viešų SEC duomenų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazīstamu investoru turējumi (13F) nāk no publiskiem SEC datiem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemfailan syarikat (13F) pelabur terkenal datang daripada data awam SEC."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjente investorers beholdninger (13F) kommer fra offentlige SEC-data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meldingen (13F) van bekende beleggers komen uit openbare SEC-gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenia (13F) znanych inwestorów pochodzą z publicznych danych SEC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições (13F) de investidores famosos vêm de dados públicos da SEC."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições (13F) de investidores famosos vêm de dados públicos da SEC."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportările (13F) ale investitorilor celebri provin din date publice SEC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёты 13F известных инвесторов взяты из открытых данных SEC."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásenia (13F) slávnych investorov pochádzajú z verejných údajov SEC."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijave podjetij (13F) znanih vlagateljev izvirajo iz javnih podatkov SEC."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijave kompanija (13F) poznatih investitora potiču iz javnih podataka SEC-a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stora investerares innehav (13F) kommer från offentliga SEC-data."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารของบริษัท (13F) ของนักลงทุนชื่อดังมาจากข้อมูลสาธารณะของ SEC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ünlü yatırımcıların şirket bildirimleri (13F) SEC'in herkese açık verilerinden gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звіти 13F відомих інвесторів взято з відкритих даних SEC."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ công ty (13F) của các nhà đầu tư nổi tiếng lấy từ dữ liệu công khai của SEC."
          }
