    "Ask about markets, a stock, or your portfolio…": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل عن الأسواق أو سهم أو محفظتك…"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Питайте за пазарите, акция или портфейла си…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাজার, কোনো শেয়ার বা আপনার পোর্টফোলিও সম্পর্কে জিজ্ঞাসা করুন…"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre els mercats, una acció o la teva cartera…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ptejte se na trhy, akcii nebo své portfolio…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg om markederne, en aktie eller din portefølje …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag nach Märkten, einer Aktie oder deinem Portfolio …"
