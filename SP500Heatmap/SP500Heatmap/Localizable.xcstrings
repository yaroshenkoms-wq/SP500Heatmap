        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atļaujiet šīs lietotnes paziņojumus iOS iestatījumos, lai saņemtu brīdinājumus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan pemberitahuan untuk apl ini dalam Tetapan iOS untuk menerima amaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat varsler for denne appen i iOS-innstillingene for å få varsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen voor deze app toe in de iOS-instellingen om meldingen te ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól tej aplikacji na powiadomienia w Ustawieniach iOS, aby otrzymywać alerty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita notificações para este app nos Ajustes do iOS para receber alertas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita notificações para este app nos Definições do iOS para receber alertas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite notificările pentru această aplicație din Setările iOS pentru a primi alerte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления этого приложения в настройках iOS, чтобы получать оповещения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte pre túto aplikáciu oznámenia v Nastaveniach iOS, aby ste dostávali upozornenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavitvah iOS dovolite obvestila za to aplikacijo, da boste prejemali opozorila."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite obaveštenja za ovu aplikaciju u podešavanjima iOS-a da biste primali upozorenja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt notiser för den här appen i iOS-inställningarna för att få aviseringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการแจ้งเตือนสำหรับแอปนี้ในการตั้งค่า iOS เพื่อรับการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı almak için iOS Ayarlarında bu uygulama için bildirimlere izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте сповіщення цього застосунку в налаштуваннях iOS, щоб отримувати сповіщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép thông báo cho ứng dụng này trong Cài đặt iOS để nhận cảnh báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中允许本应用发送通知以接收提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iOS 設定中允許此 App 傳送通知，以接收提醒。"
          }
        }
      }
    },
