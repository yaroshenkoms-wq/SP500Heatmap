    "AI-generated, may be inaccurate. Not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُنشأ بالذكاء الاصطناعي وقد يكون غير دقيق. ليس نصيحة استثمارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এআই দ্বারা তৈরি, ভুল হতে পারে। বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-generated, may be inaccurate. Not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generado por IA, puede contener errores. No es asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré par IA, peut être inexact. Ne constitue pas un conseil en investissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई द्वारा बनाया गया, गलत हो सकता है। निवेश सलाह नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано ИИ, может содержать ошибки. Не является инвестиционной рекомендацией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено ШІ, може бути неточним. Не є інвестиційною порадою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 AI 生成,可能不准确。不构成投资建议。"
          }
        }
      }
    },
