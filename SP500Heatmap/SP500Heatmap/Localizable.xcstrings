    "The on-device model couldn't answer. Try rephrasing, or use a quick answer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على النموذج الموجود على الجهاز الإجابة. أعد صياغة السؤال أو استخدم إجابة سريعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসের মডেল উত্তর দিতে পারেনি। প্রশ্নটি অন্যভাবে লিখুন বা দ্রুত উত্তর ব্যবহার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model couldn't answer. Try rephrasing, or use a quick answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo del dispositivo no pudo responder. Reformula la pregunta o usa una respuesta rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sur l’appareil n’a pas pu répondre. Reformulez ou utilisez une réponse rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस का मॉडल उत्तर नहीं दे सका। प्रश्न दूसरे शब्दों में पूछें या त्वरित उत्तर इस्तेमाल करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель на устройстве не смогла ответить. Переформулируйте вопрос или используйте быстрый ответ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель на пристрої не змогла відповісти. Переформулюйте запитання або скористайтеся швидкою відповіддю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型无法回答。请换种说法，或使用快速回答。"
          }
        }
      }
    },
    "The price is filled from the daily close of that date; you can change it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُملأ السعر من إغلاق ذلك اليوم؛ يمكنك تغييره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দাম ওই তারিখের সমাপনী মূল্য থেকে ভরা হয়; আপনি বদলাতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price is filled from the daily close of that date; you can change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio se rellena con el cierre diario de esa fecha; puedes cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cours est prérempli avec la clôture de cette date ; vous pouvez le modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य उस तारीख के समापन भाव से भरा जाता है; आप इसे बदल सकते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена подставляется по закрытию этого дня; её можно изменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна підставляється за закриттям цього дня; її можна змінити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格取自该日期的收盘价，可以修改。"
          }
        }
      }
    },
