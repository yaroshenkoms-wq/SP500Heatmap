    "Tap the live icon on an index map to follow it on the Lock Screen and in the Dynamic Island. The server updates it even when the app is closed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أيقونة البث المباشر في خريطة المؤشر لمتابعته على شاشة القفل وفي Dynamic Island. يحدّثه الخادم حتى عند إغلاق التطبيق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете иконата „на живо“ на картата на индекс, за да го следите на заключения екран и в Dynamic Island. Сървърът го обновява дори когато приложението е затворено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনডেক্স ম্যাপে লাইভ আইকনে ট্যাপ করে লক স্ক্রিন ও ডাইনামিক আইল্যান্ডে অনুসরণ করুন। অ্যাপ বন্ধ থাকলেও সার্ভার এটি আপডেট করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la icona en directe d'un mapa d'índex per seguir-lo a la pantalla de bloqueig i a la Dynamic Island. El servidor l'actualitza fins i tot amb l'app tancada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na živou ikonu na mapě indexu a sledujte jej na zamčené obrazovce a v Dynamic Island. Server jej aktualizuje i při zavřené aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på live-ikonet på et indekskort for at følge det på låseskærmen og i Dynamic Island. Serveren opdaterer det, selv når appen er lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf dem Indexchart auf das Live-Symbol, um ihm auf dem Sperrbildschirm und in der Dynamic Island zu folgen. Der Server aktualisiert es auch bei geschlossener App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το εικονίδιο ζωντανής παρακολούθησης σε έναν χάρτη δείκτη για να τον ακολουθείτε στην Οθόνη Κλειδώματος και στο Dynamic Island. Ο διακομιστής τον ενημερώνει ακόμη και όταν η εφαρμογή είναι κλειστή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the live icon on an index map to follow it on the Lock Screen and in the Dynamic Island. The server updates it even when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el icono en directo en el mapa de un índice para seguirlo en la pantalla de bloqueo y en la Dynamic Island. El servidor lo actualiza incluso con la app cerrada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta indeksikaardil live-ikooni, et jälgida seda lukustuskuval ja Dynamic Islandis. Server uuendab seda ka siis, kui rakendus on suletud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta indeksikartan live-kuvaketta seurataksesi sitä lukitusnäytöllä ja Dynamic Islandissa. Palvelin päivittää sen, vaikka sovellus olisi suljettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'icône en direct sur la carte d'un indice pour le suivre sur l'écran verrouillé et dans la Dynamic Island. Le serveur le met à jour même app fermée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על סמל החי במפת מדד כדי לעקוב אחריו במסך הנעילה וב-Dynamic Island. השרת מעדכן אותו גם כשהאפליקציה סגורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी इंडेक्स मैप पर लाइव आइकन टैप करें और लॉक स्क्रीन व डायनामिक आइलैंड पर उसे फ़ॉलो करें। ऐप बंद होने पर भी सर्वर इसे अपडेट करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite ikonu uživo na karti indeksa da ga pratite na zaključanom zaslonu i u Dynamic Islandu. Server ga ažurira čak i kad je aplikacija zatvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson az élő ikonra egy indextérképen, hogy kövesse a Lezárási képernyőn és a Dynamic Islanden. A szerver akkor is frissíti, ha az alkalmazás be van zárva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ikon langsung pada peta indeks untuk mengikutinya di Layar Kunci dan Dynamic Island. Server memperbaruinya bahkan saat aplikasi ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l'icona live su una mappa dell'indice per seguirlo nella schermata di blocco e nella Dynamic Island. Il server lo aggiorna anche con l'app chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指数マップのライブアイコンをタップすると、ロック画面とDynamic Islandで追跡できます。アプリを閉じていてもサーバーが更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지수 맵의 라이브 아이콘을 탭하면 잠금 화면과 다이내믹 아일랜드에서 팔로우할 수 있습니다. 앱을 닫아도 서버가 업데이트합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite tiesioginės veiklos piktogramą indekso žemėlapyje, kad sektumėte jį užrakinimo ekrane ir „Dynamic Island“. Serveris jį atnaujina net kai programėlė uždaryta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties tiešraides ikonai indeksa kartē, lai sekotu tam bloķēšanas ekrānā un Dynamic Island. Serveris to atjaunina arī tad, ja lietotne ir aizvērta."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ikon langsung pada peta indeks untuk mengikutinya pada Skrin Kunci dan Dynamic Island. Pelayan mengemas kininya walaupun apl ditutup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på live-ikonet på et indekskart for å følge det på låseskjermen og i Dynamic Island. Serveren oppdaterer det selv når appen er lukket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het live-pictogram op een indexkaart om die te volgen op het toegangsscherm en in het Dynamic Island. De server werkt het bij, ook als de app gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ikonę na żywo na mapie indeksu, aby śledzić go na ekranie blokady i w Dynamic Island. Serwer aktualizuje go nawet przy zamkniętej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ícone ao vivo em um mapa de índice para acompanhá-lo na Tela Bloqueada e na Dynamic Island. O servidor o atualiza mesmo com o app fechado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ícone em direto em um mapa de índice para acompanhá-lo na Ecrã de Bloqueio e na Dynamic Island. O servidor o atualiza mesmo com o app fechado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pictograma live de pe harta unui indice pentru a-l urmări pe ecranul de blocare și în Dynamic Island. Serverul îl actualizează chiar și cu aplicația închisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите значок «live» на карте индекса, чтобы следить за ним на экране блокировки и в Dynamic Island. Сервер обновляет его, даже когда приложение закрыто."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na živú ikonu na mape indexu a sledujte ho na uzamknutej obrazovke a v Dynamic Island. Server ho aktualizuje aj pri zatvorenej aplikácii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite ikono v živo na zemljevidu indeksa, da ga spremljate na zaklenjenem zaslonu in v Dynamic Islandu. Strežnik ga posodablja, tudi ko je aplikacija zaprta."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite ikonu uživo na mapi indeksa da ga pratite na zaključanom ekranu i u Dynamic Islandu. Server ga ažurira čak i kad je aplikacija zatvorena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på live-ikonen på en indexkarta för att följa den på låsskärmen och i Dynamic Island. Servern uppdaterar den även när appen är stängd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไอคอนสดบนแผนที่ดัชนีเพื่อติดตามบนหน้าจอล็อกและ Dynamic Island เซิร์ฟเวอร์จะอัปเดตให้แม้ปิดแอปอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit Ekranı'nda ve Dynamic Island'da takip etmek için endeks haritasındaki canlı simgeye dokunun. Uygulama kapalıyken bile sunucu günceller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть значок «live» на карті індексу, щоб стежити за ним на екрані блокування й у Dynamic Island. Сервер оновлює його, навіть коли застосунок закрито."
          }
