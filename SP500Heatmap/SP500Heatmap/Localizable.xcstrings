    "Headlines come from public sources. AI-generated summaries may be inaccurate. Not investment advice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين من مصادر عامة. قد تكون الملخصات التي ينشئها الذكاء الاصطناعي غير دقيقة. ليست نصيحة استثمارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনামগুলো পাবলিক উৎস থেকে নেওয়া। AI-তৈরি সারাংশ ভুল হতে পারে। এটি বিনিয়োগ পরামর্শ নয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headlines come from public sources. AI-generated summaries may be inaccurate. Not investment advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los titulares proceden de fuentes públicas. Los resúmenes de IA pueden contener errores. No es asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres proviennent de sources publiques. Les résumés générés par l’IA peuvent être inexacts. Ce n’est pas un conseil en investissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडलाइन सार्वजनिक स्रोतों से ली गई हैं। AI द्वारा बनाए सारांश गलत हो सकते हैं। यह निवेश सलाह नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки взяты из открытых источников. Сводки, созданные ИИ, могут быть неточными. Это не инвестиционная рекомендация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки взято з відкритих джерел. Зведення, створені ШІ, можуть бути неточними. Це не інвестиційна порада."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题来自公开来源。AI 生成的摘要可能不准确。不构成投资建议。"
          }
        }
      }
    },
