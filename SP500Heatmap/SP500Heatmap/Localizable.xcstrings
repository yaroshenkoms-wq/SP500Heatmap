        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل خادمنا التنبيهات الفورية حتى عند إغلاق التطبيق. تنبيهات الأخبار تتطلب الإشعارات الفورية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Push известията се изпращат от нашия сървър, дори когато приложението е затворено. Известията за новини изискват push."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ বন্ধ থাকলেও আমাদের সার্ভার পুশ অ্যালার্ট পাঠায়। খবরের অ্যালার্টের জন্য পুশ দরকার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els avisos push els envia el nostre servidor, fins i tot amb l'app tancada. Els avisos de notícies necessiten push."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Push upozornění odesílá náš server, i když je aplikace zavřená. Upozornění na zprávy vyžadují push."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushalarmer sendes fra vores server, også når appen er lukket. Nyhedsalarmer kræver push."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Alarme werden von unserem Server gesendet, auch wenn die App geschlossen ist. Nachrichtenalarme benötigen Push."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις push αποστέλλονται από τον διακομιστή μας, ακόμη και όταν η εφαρμογή είναι κλειστή. Οι ειδοποιήσεις ειδήσεων απαιτούν push."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push alerts are sent by our server, even when the app is closed. News alerts need push."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas push las envía nuestro servidor, incluso con la app cerrada. Las alertas de noticias requieren push."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-teavitusi saadab meie server ka siis, kui rakendus on suletud. Uudisteavitused vajavad push-teavitusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-hälytykset lähetetään palvelimeltamme, vaikka sovellus olisi suljettu. Uutishälytykset vaativat push-ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes push sont envoyées par notre serveur, même app fermée. Les alertes d'actualités nécessitent le push."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות Push נשלחות על ידי השרת שלנו, גם כשהאפליקציה סגורה. התראות חדשות דורשות Push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होने पर भी हमारा सर्वर पुश अलर्ट भेजता है। खबरों के अलर्ट के लिए पुश ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push obavijesti šalje naš server, čak i kad je aplikacija zatvorena. Upozorenja o vijestima zahtijevaju push."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A push-értesítéseket a szerverünk küldi, akkor is, ha az alkalmazás be van zárva. A hírértesítésekhez push szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan push dikirim oleh server kami, bahkan saat aplikasi ditutup. Peringatan berita memerlukan push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi push vengono inviati dal nostro server, anche con l'app chiusa. Gli avvisi sulle notizie richiedono le notifiche push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュアラートはアプリを閉じていてもサーバーから送信されます。ニュースアラートにはプッシュ通知が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸시 알림은 앱을 닫아도 서버에서 전송됩니다. 뉴스 알림에는 푸시가 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Push pranešimus siunčia mūsų serveris, net kai programėlė uždaryta. Naujienų įspėjimams reikia push."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Push brīdinājumus sūta mūsu serveris, arī tad, ja lietotne ir aizvērta. Ziņu brīdinājumiem nepieciešams push."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran push dihantar oleh pelayan kami, walaupun apl ditutup. Amaran berita memerlukan push."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushvarsler sendes fra serveren vår, selv når appen er lukket. Nyhetsvarsler krever push."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushmeldingen worden door onze server verstuurd, ook als de app gesloten is. Nieuwsmeldingen vereisen push."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty push są wysyłane przez nasz serwer, nawet gdy aplikacja jest zamknięta. Alerty o wiadomościach wymagają powiadomień push."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas push são enviados pelo nosso servidor, mesmo com o app fechado. Alertas de notícias exigem push."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas push são enviados pelo nosso servidor, mesmo com o app fechado. Alertas de notícias exigem push."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele push sunt trimise de serverul nostru, chiar și cu aplicația închisă. Alertele de știri necesită notificări push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-оповещения отправляет наш сервер, даже когда приложение закрыто. Для новостей нужен push."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push upozornenia odosiela náš server, aj keď je aplikácia zatvorená. Upozornenia na správy vyžadujú push."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Push obvestila pošilja naš strežnik, tudi ko je aplikacija zaprta. Opozorila o novicah zahtevajo push."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Push obaveštenja šalje naš server, čak i kad je aplikacija zatvorena. Upozorenja o vestima zahtevaju push."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushaviseringar skickas av vår server, även när appen är stängd. Nyhetsaviseringar kräver push."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนแบบพุชส่งจากเซิร์ฟเวอร์ของเรา แม้ปิดแอปอยู่ การแจ้งเตือนข่าวต้องใช้การพุช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık bildirim uyarıları, uygulama kapalıyken bile sunucumuz tarafından gönderilir. Haber uyarıları için anlık bildirim gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-сповіщення надсилає наш сервер, навіть коли застосунок закрито. Для новин потрібен push."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo đẩy do máy chủ của chúng tôi gửi, kể cả khi ứng dụng đã đóng. Cảnh báo tin tức cần thông báo đẩy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送提醒由我们的服务器发送，即使应用已关闭也会收到。新闻提醒需要推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推播提醒由我們的伺服器發送，即使 App 已關閉也會收到。新聞提醒需要推播。"
          }
        }
      }
    },
