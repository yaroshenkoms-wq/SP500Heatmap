    "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume and turnover apply to company maps; world and sector maps use market cap where there is no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen y el volumen negociado se aplican a los mapas de empresas; donde no hay datos se usa la capitalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成交量和成交额用于公司地图；没有数据的地图使用市值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم وقيمة التداول يُطبَّقان على خرائط الشركات؛ وحيث لا توجد بيانات تُستخدم القيمة السوقية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume et le montant échangé s'appliquent aux cartes des sociétés ; sans données, la capitalisation est utilisée."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভলিউম ও লেনদেনের মূল্য কোম্পানির মানচিত্রে প্রযোজ্য; তথ্য না থাকলে বাজার মূলধন ব্যবহৃত হয়।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम और कारोबार कंपनी मानचित्रों पर लागू होते हैं; डेटा न होने पर बाज़ार पूँजी इस्तेमाल होती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объём и оборот работают на картах компаний; где данных нет, используется капитализация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсяг і оборот працюють на картах компаній; де даних немає, використовується капіталізація."
          }
        }
      }
    },
    "Add buys, sells and dividends to see value, profit, allocation and performance against an index.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add buys, sells and dividends to see value, profit, allocation and performance against an index."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade compras, ventas y dividendos para ver valor, beneficio, distribución y rentabilidad frente a un índice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加买入、卖出和股息，即可查看市值、收益、配置以及相对指数的表现。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عمليات الشراء والبيع والأرباح لعرض القيمة والربح والتوزيع والأداء مقابل مؤشر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez achats, ventes et dividendes pour voir la valeur, le gain, la répartition et la performance face à un indice."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য, লাভ, বণ্টন এবং সূচকের তুলনায় পারফরম্যান্স দেখতে ক্রয়, বিক্রয় ও লভ্যাংশ যোগ করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल्य, लाभ, आवंटन और इंडेक्स के मुकाबले प्रदर्शन देखने के लिए खरीद, बिक्री और लाभांश जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте покупки, продажи и дивиденды, чтобы увидеть стоимость, прибыль, структуру и доходность в сравнении с индексом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте купівлі, продажі та дивіденди, щоб побачити вартість, прибуток, структуру й дохідність порівняно з індексом."
          }
        }
      }
    },
