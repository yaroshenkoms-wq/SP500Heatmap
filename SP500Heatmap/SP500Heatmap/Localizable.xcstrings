    "Add transactions in the Portfolio tab first, then I can summarize it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عمليات في تبويب المحفظة أولاً، ثم يمكنني تلخيصها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে পোর্টফোলিও ট্যাবে লেনদেন যোগ করুন, তারপর আমি সারাংশ দিতে পারব।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add transactions in the Portfolio tab first, then I can summarize it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero añade operaciones en la pestaña Cartera y después podré resumirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord des opérations dans l’onglet Portefeuille, puis je pourrai le résumer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले पोर्टफ़ोलियो टैब में लेन-देन जोड़ें, फिर मैं सारांश दे सकूँगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте сделки на вкладке «Портфель», тогда я смогу сделать сводку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу додайте угоди на вкладці «Портфель», тоді я зможу зробити зведення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“投资组合”标签中添加交易，之后我才能为您总结。"
          }
        }
      }
    },
