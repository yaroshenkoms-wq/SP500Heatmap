    "Allow Live Activities for this app in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالأنشطة المباشرة لهذا التطبيق في إعدادات iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংসে এই অ্যাপের জন্য লাইভ অ্যাক্টিভিটি অনুমোদন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Live Activities for this app in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las actividades en directo de esta app en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les activités en direct pour cette app dans les Réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स में इस ऐप के लिए लाइव एक्टिविटी की अनुमति दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Live Activities для этого приложения в настройках iOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Live Activities для цього застосунку в налаштуваннях iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中允许此应用使用实时活动。"
          }
        }
      }
    },
    "Allow notifications for this app in iOS Settings to get alerts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالإشعارات لهذا التطبيق من إعدادات iOS لتلقي التنبيهات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সতর্কতা পেতে iOS সেটিংসে এই অ্যাপের বিজ্ঞপ্তি অনুমোদন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for this app in iOS Settings to get alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones de esta app en los Ajustes de iOS para recibir alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications de cette app dans les Réglages iOS pour recevoir des alertes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट पाने के लिए iOS सेटिंग्स में इस ऐप की सूचनाएँ अनुमति दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления этого приложения в настройках iOS, чтобы получать оповещения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте сповіщення цього застосунку в налаштуваннях iOS, щоб отримувати сповіщення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中允许本应用发送通知以接收提醒。"
          }
        }
      }
    },
