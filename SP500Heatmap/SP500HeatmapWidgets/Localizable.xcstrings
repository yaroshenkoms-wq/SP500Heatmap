        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite mėgstamiausių programėlėje: bakstelėkite įmonės žvaigždutę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
