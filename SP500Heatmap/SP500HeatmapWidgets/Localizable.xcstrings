    "Add favorites in the app: tap the star on a company.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف المفضلة في التطبيق: اضغط على النجمة في شركة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете любими в приложението: докоснете звездата при компания."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপে পছন্দের যোগ করুন: কোম্পানির তারা চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix preferits a l'app: toca l'estrella d'una empresa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte oblíbené v aplikaci: klepněte na hvězdičku u společnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj favoritter i appen: tryk på stjernen på en virksomhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in der App Favoriten hinzu: Tippe bei einem Unternehmen auf den Stern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε αγαπημένα στην εφαρμογή: πατήστε το αστέρι σε μια εταιρεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add favorites in the app: tap the star on a company."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade favoritos en la app: toca la estrella de una empresa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa lemmikuid rakenduses: puuduta ettevõtte tähte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää suosikkeja sovelluksessa: napauta yrityksen tähteä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des favoris dans l’app : touchez l’étoile d’une entreprise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו מועדפים באפליקציה: הקישו על הכוכב בחברה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में पसंदीदा जोड़ें: किसी कंपनी के तारे पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte favorite u aplikaciji: dodirnite zvjezdicu na tvrtki."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá kedvenceket az alkalmazásban: koppintson egy cég csillagára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan favorit di aplikasi: ketuk bintang pada sebuah perusahaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i preferiti nell'app: tocca la stella su un'azienda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでお気に入りを追加：企業の星をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 즐겨찾기를 추가하세요: 기업의 별표를 탭합니다."
