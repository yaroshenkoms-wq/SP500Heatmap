          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kegemaran dalam apl: ketik bintang pada sesebuah syarikat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til favoritter i appen: trykk på stjernen på et selskap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg favorieten toe in de app: tik op de ster bij een bedrijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj ulubione w aplikacji: stuknij gwiazdkę przy spółce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
