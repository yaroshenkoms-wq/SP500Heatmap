    "A map of regions and indices coloured by today's change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة للمناطق والمؤشرات ملوّنة حسب تغير اليوم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта на региони и индекси, оцветена според днешната промяна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের পরিবর্তন অনুযায়ী রঙ করা অঞ্চল ও সূচকের মানচিত্র।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mapa de regions i índexs acolorit segons la variació d'avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa regionů a indexů obarvená podle dnešní změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kort over regioner og indeks, farvet efter dagens ændring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte der Regionen und Indizes, eingefärbt nach der heutigen Veränderung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χάρτης περιοχών και δεικτών χρωματισμένος με τη σημερινή μεταβολή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A map of regions and indices coloured by today's change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mapa de regiones e índices coloreado según la variación de hoy."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirkondade ja indeksite kaart, mis on värvitud tänase muutuse järgi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartta alueista ja indekseistä, väritettynä tämänpäiväisen muutoksen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte des régions et indices colorée selon la variation du jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפת אזורים ומדדים הצבועה לפי השינוי היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के बदलाव के अनुसार रंगे क्षेत्रों और सूचकांकों का मानचित्र।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta regija i indeksa obojena prema današnjoj promjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Régiók és indexek térképe a mai változás szerint színezve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peta wilayah dan indeks yang diwarnai menurut perubahan hari ini."
          }
        },
        "it": {
          "stringUnit": {
