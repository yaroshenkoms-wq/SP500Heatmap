    "A map of regions and indices coloured by today's change." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة للمناطق والمؤشرات ملوّنة حسب تغير اليوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের পরিবর্তন অনুযায়ী রঙ করা অঞ্চল ও সূচকের মানচিত্র।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A map of regions and indices coloured by today's change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mapa de regiones e índices coloreado según la variación de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une carte des régions et indices colorée selon la variation du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज के बदलाव के अनुसार रंगे क्षेत्रों और सूचकांकों का मानचित्र।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта регионов и индексов, окрашенная по изменению за сегодня."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта регіонів та індексів, забарвлена за зміною за сьогодні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按今日涨跌着色的地区和指数地图。"
          }
        }
      }
    },
    "Add favorites in the app: tap the star on a company." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
